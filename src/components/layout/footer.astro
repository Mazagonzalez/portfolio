---
import { socialLinks } from "@/data/social";
import { useTranslations } from "@/i18n";

const __ = useTranslations(Astro.currentLocale);

const year = new Date().getFullYear();
---

<!-- Bottom padding keeps the last line clear of the floating dock -->
<footer class="size-screen relative z-10 pb-28">
    <div class="col gap-6">
        <div class="row flex-wrap items-center justify-between gap-6">
            <div class="col gap-1">
                <p class="text-lg font-semibold">
                    Carlos Maza
                </p>

                <p class="text-sm text-muted">
                    {__("Frontend developer building fast, thoughtful web experiences.")}
                </p>
            </div>

            <ul class="row items-center gap-5" aria-label={__("Social links")}>
                {socialLinks.map(({ url, label, icon: Icon, target }) => (
                    <li>
                        <a
                            href={url}
                            target={target === false ? "_self" : "_blank"}
                            rel="noopener noreferrer"
                            aria-label={__(label)}
                        >
                            <Icon class="icon" />
                        </a>
                    </li>
                ))}
            </ul>
        </div>

        <hr class="h-px w-full border-0 bg-white/10" />

        <p class="text-xs text-muted text-end">
            <small class="text-xs">&copy; {year} Carlos Maza. {__("All rights reserved.")}</small>
        </p>
    </div>
</footer>
