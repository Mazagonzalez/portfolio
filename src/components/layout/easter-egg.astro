---
// Konami code (↑ ↑ ↓ ↓ ← → ← → B A) sends the sky to lightspeed
import { useTranslations } from "@/i18n";

const __ = useTranslations(Astro.currentLocale);
---

<p
    id="lightspeedToast"
    role="status"
    data-unlocked={__("🚀 Lightspeed unlocked")}
    data-found={__("🚀 Lightspeed unlocked. You found the secret!")}
    class="fixed top-6 left-1/2 z-101 -translate-x-1/2 box-gen bg-zinc-900/85! px-4 py-2 text-sm whitespace-nowrap pointer-events-none opacity-0 -translate-y-2 transition-all duration-300 data-active:opacity-100 data-active:translate-y-0"
></p>

<script>
    const SEQUENCE = ["arrowup", "arrowup", "arrowdown", "arrowdown", "arrowleft", "arrowright", "arrowleft", "arrowright", "b", "a"];
    const WARP_MS = 2600;

    const recent: string[] = [];
    let running = false;

    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const warp = (on: boolean) => window.dispatchEvent(new CustomEvent("sky:warp", { detail: on }));

    // The messages come translated in the toast's data-* attributes
    async function showToast(message: "unlocked" | "found") {
        const toast = document.getElementById("lightspeedToast");
        if (!toast) return;

        toast.textContent = toast.dataset[message] ?? "";
        toast.dataset.active = "";
        await wait(3200);
        delete toast.dataset.active;
    }

    async function jumpToLightspeed() {
        if (running) return;
        running = true;

        // With reduced motion the sky ignores the jump: keep the reward only
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

        warp(true);
        showToast(reduced ? "unlocked" : "found");

        await wait(WARP_MS);
        warp(false);
        running = false;
    }

    document.addEventListener("keydown", (event) => {
        const target = event.target as HTMLElement;
        // Ignore typing in fields and the command palette
        if (target.closest("input, textarea, [contenteditable], dialog[open]")) return;

        // Keep the last keys pressed and compare them with the sequence
        recent.push(event.key.toLowerCase());
        if (recent.length > SEQUENCE.length) recent.shift();

        if (recent.join() === SEQUENCE.join()) {
            recent.length = 0;
            jumpToLightspeed();
        }
    });

    // Kept on one line: the Console Ninja VS Code extension rewrites console
    // calls and breaks Vite's dependency scan when the call spans several lines
    const hint = "%cpsst… try ↑ ↑ ↓ ↓ ← → ← → B A", hintStyle = "color: #7453ED; font-size: 12px; font-family: monospace;";
    console.log(hint, hintStyle);
</script>
