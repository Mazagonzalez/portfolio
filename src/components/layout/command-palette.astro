---
import IconSearch from "@/components/icons/icon-search.astro";
import IconHome from "@/components/icons/icon-home.astro";
import IconUser from "@/components/icons/icon-user.astro";
import IconProjects from "@/components/icons/icon-projects.astro";
import IconStart from "@/components/icons/icon-start.astro";
import IconCode from "@/components/icons/icon-code.astro";
import IconEmail from "@/components/icons/icon-email.astro";
import IconDownload from "@/components/icons/icon-download.astro";
import IconMusic from "@/components/icons/icon-music.astro";
import IconBook from "@/components/icons/icon-book.astro";
import IconLanguage from "@/components/icons/icon-language.astro";

import { getProjects } from "@/data/projects";
import { getPosts, formatDate } from "@/data/blog";
import { email, socialLinks } from "@/data/social";
import { useTranslations, getLocale, localizePath } from "@/i18n";

interface Item {
    label: string;
    icon: (props: Record<string, any>) => any;
    href?: string;
    action?: "copy-email" | "toggle-music" | "switch-language";
    hint?: string;
    keywords?: string;
    download?: boolean;
    external?: boolean;
    // Only shown when that element exists on the current page
    requires?: "player" | "switcher";
}

const locale = getLocale(Astro.currentLocale);
const __ = useTranslations(locale);
const link = (path: string) => localizePath(path, locale);

const kbd = "min-w-5 px-1.5 py-0.5 rounded border border-white/10 bg-white/5 font-[inherit] text-center text-[10px] text-white/50";

const projects = await getProjects();
const posts = await getPosts();

const groups: { label: string; items: Item[] }[] = [
    {
        label: __("Pages"),
        items: [
            { label: __("Home"), href: link("/"), icon: IconHome, keywords: "home start index" },
            { label: __("About"), href: link("/about"), icon: IconUser, keywords: "about me story bio" },
            { label: __("Projects"), href: link("/projects"), icon: IconProjects, keywords: "projects work portfolio" },
            { label: __("Skills"), href: link("/skills"), icon: IconStart, keywords: "skills stack tech tools" },
            { label: __("Blog"), href: link("/blog"), icon: IconBook, keywords: "posts articles notes writing" },
        ],
    },
    {
        label: __("Projects"),
        items: projects.map(({ id, data }) => ({
            label: data.name,
            href: link(`/projects/${id}`),
            icon: IconCode,
            hint: data.stack.slice(0, 3).join(" · "),
            keywords: `project ${data.category} ${data.stack.join(" ")}`,
        })),
    },
    {
        label: "Blog",
        items: posts.slice(0, 6).map(({ id, data }) => ({
            label: data.title,
            href: link(`/blog/${id}`),
            icon: IconBook,
            hint: formatDate(data.pubDate),
            keywords: `post article ${data.tags.join(" ")}`,
        })),
    },
    {
        label: __("Actions"),
        items: [
            { label: __("Copy email"), action: "copy-email", icon: IconEmail, hint: email, keywords: "copy contact mail" },
            { label: __("Send an email"), href: `mailto:${email}`, icon: IconEmail, keywords: "send contact mail write" },
            { label: __("Download CV"), href: "/Carlos-Maza-CV.pdf", download: true, icon: IconDownload, keywords: "download resume curriculum pdf" },
            { label: __("Play music"), action: "toggle-music", icon: IconMusic, keywords: "play song player pause audio", requires: "player" },
            // Always written in the other language, so it can be found by whoever needs it
            {
                label: locale === "es" ? "View in English" : "Ver en español",
                action: "switch-language",
                icon: IconLanguage,
                keywords: "language idioma english inglés spanish español translate traducir",
                requires: "switcher",
            },
        ],
    },
    {
        label: __("Social"),
        items: socialLinks
            .filter((link) => link.target)
            .map(({ label, url, icon }) => ({ label: __(label), href: url, external: true, icon, keywords: "social profile" })),
    },
];
---

<!-- Persisted between pages of the same language; switching languages swaps it for the translated one -->
<dialog
    id="cmdk"
    aria-label={__("Command palette")}
    transition:persist={`command-palette-${locale}`}
    data-copied={__("Copied!")}
    data-copy-failed={__("Couldn't copy")}
    data-play={__("Play music")}
    data-pause={__("Pause music")}
    class="w-[min(560px,calc(100%-32px))] max-w-none mx-auto mt-[15vh] p-0 bg-transparent text-white overflow-visible backdrop:bg-black/50 backdrop:backdrop-blur-xs backdrop:animate-overlay-in motion-reduce:backdrop:animate-none"
>
    <div class="box-gen bg-zinc-900/85! overflow-hidden shadow-2xl shadow-black/50 animate-pop-in motion-reduce:animate-none">
        <div class="row items-center gap-3 px-4 border-b border-white/10">
            <IconSearch class="size-4 shrink-0 stroke-muted" />

            <input
                id="cmdkInput"
                type="text"
                role="combobox"
                aria-expanded="true"
                aria-controls="cmdkList"
                aria-autocomplete="list"
                aria-label={__("Search pages, projects and actions")}
                placeholder={__("Search pages, projects, actions…")}
                autocomplete="off"
                spellcheck="false"
                class="w-full bg-transparent py-4 text-sm outline-none placeholder:text-white/50"
            />

            <kbd class:list={[kbd, "hidden sm:block"]}>esc</kbd>
        </div>

        <div id="cmdkList" role="listbox" aria-label={__("Results")} class="max-h-[min(22rem,55vh)] overflow-y-auto scrollbar p-2">
            {groups.filter((group) => group.items.length > 0).map((group, g) => (
                <div role="group" aria-labelledby={`cmdk-group-${g}`} class="cmdk-group">
                    <p id={`cmdk-group-${g}`} class="px-2.5 pt-2 pb-1.5 text-[11px] uppercase tracking-wider text-white/50">
                        {group.label}
                    </p>

                    {group.items.map((item, i) => (
                        <div
                            id={`cmdk-option-${g}-${i}`}
                            role="option"
                            aria-selected="false"
                            class="flex items-center gap-3 p-2.5 rounded-lg text-sm text-white/80 cursor-pointer scroll-mt-10 scroll-mb-2 aria-selected:bg-white/10 aria-selected:text-white aria-selected:[&_svg]:stroke-white"
                            data-search={`${item.label} ${item.keywords ?? ""}`.toLowerCase()}
                            data-href={item.href}
                            data-action={item.action}
                            data-download={item.download ? "" : undefined}
                            data-external={item.external ? "" : undefined}
                            data-requires={item.requires}
                        >
                            <item.icon class="size-4 shrink-0 stroke-muted" />
                            <span class="cmdk-label truncate">{item.label}</span>
                            {item.hint && <span class="cmdk-hint ml-auto truncate text-xs text-white/50">{item.hint}</span>}
                            {item.external && <span class="sr-only">{__("(opens in a new tab)")}</span>}
                        </div>
                    ))}
                </div>
            ))}

            <p id="cmdkEmpty" hidden class="py-10 text-center text-sm text-muted">
                {__("No results")}
            </p>
        </div>

        <div class="hidden sm:flex items-center gap-4 px-4 py-2.5 border-t border-white/10 text-[11px] text-white/50" aria-hidden="true">
            <span class="row items-center gap-1.5"><kbd class={kbd}>↑</kbd><kbd class={kbd}>↓</kbd> {__("navigate")}</span>
            <span class="row items-center gap-1.5"><kbd class={kbd}>↵</kbd> {__("open")}</span>
            <span class="row items-center gap-1.5 ml-auto"><kbd class={kbd} data-cmdk-shortcut>Ctrl K</kbd> {__("toggle")}</span>
        </div>
    </div>
</dialog>

<script>
    import { navigate } from "astro:transitions/client";
    import { copyText } from "@/scripts/clipboard";

    // The dialog is persisted across navigations within a language. When the
    // language changes, a new (translated) dialog arrives and setup() wires it
    let dialog: HTMLDialogElement;
    let input: HTMLInputElement;
    let empty: HTMLElement;
    let groups: HTMLElement[] = [];
    let options: HTMLElement[] = [];

    const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent);
    let activeIndex = -1;

    const visibleOptions = () => options.filter((option) => !option.hidden);

    function setActive(index: number) {
        const visible = visibleOptions();
        options.forEach((option) => option.setAttribute("aria-selected", "false"));

        if (visible.length === 0) {
            activeIndex = -1;
            input.removeAttribute("aria-activedescendant");
            return;
        }

        activeIndex = (index + visible.length) % visible.length;
        const option = visible[activeIndex];
        option.setAttribute("aria-selected", "true");
        input.setAttribute("aria-activedescendant", option.id);
        option.scrollIntoView({ block: "nearest" });
    }

    function filter(query: string) {
        const words = query.toLowerCase().split(/\s+/).filter(Boolean);
        const present = {
            player: Boolean(document.getElementById("playBtn")),
            switcher: Boolean(document.querySelector("[data-switch-locale]")),
        };

        options.forEach((option) => {
            const matches = words.every((word) => option.dataset.search!.includes(word));
            const requires = option.dataset.requires as keyof typeof present | undefined;
            const available = !requires || present[requires];
            option.hidden = !matches || !available;
        });

        groups.forEach((group) => {
            group.hidden = !group.querySelector("[role='option']:not([hidden])");
        });

        empty.hidden = visibleOptions().length > 0;
        setActive(0);
    }

    function updateMusicLabel() {
        const player = document.getElementById("player") as HTMLAudioElement | null;
        const label = dialog.querySelector("[data-action='toggle-music'] .cmdk-label");
        if (label) label.textContent = player && !player.paused ? dialog.dataset.pause! : dialog.dataset.play!;
    }

    function open() {
        if (dialog.open) return;
        input.value = "";
        updateMusicLabel();
        filter("");
        dialog.showModal();
        input.focus();
    }

    function close() {
        if (dialog.open) dialog.close();
    }

    async function copyEmail(option: HTMLElement) {
        const hint = option.querySelector(".cmdk-hint");
        const address = hint?.textContent ?? "";

        const copied = await copyText(address, dialog);
        input.focus();
        if (hint) hint.textContent = copied ? dialog.dataset.copied! : dialog.dataset.copyFailed!;

        setTimeout(() => {
            close();
            if (hint) hint.textContent = address;
        }, 700);
    }

    function run(option: HTMLElement | undefined) {
        if (!option) return;
        const { href, action } = option.dataset;

        if (action === "copy-email") {
            copyEmail(option);
            return;
        }

        close();

        if (action === "toggle-music") {
            document.getElementById("playBtn")?.click();
        } else if (action === "switch-language") {
            document.querySelector<HTMLAnchorElement>("[data-switch-locale]")?.click();
        } else if (href && "download" in option.dataset) {
            const link = document.createElement("a");
            link.href = href;
            link.download = "";
            link.click();
        } else if (href && "external" in option.dataset) {
            window.open(href, "_blank", "noopener");
        } else if (href?.startsWith("mailto:")) {
            window.location.href = href;
        } else if (href) {
            navigate(href);
        }
    }

    // Ctrl+K / Cmd+K anywhere toggles the palette
    document.addEventListener("keydown", (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
            event.preventDefault();
            dialog.open ? close() : open();
        }
    });

    // Any element with data-cmdk-open (like the dock button) opens it
    document.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).closest("[data-cmdk-open]")) open();
    });

    document.addEventListener("astro:before-swap", close);

    function setup() {
        const current = document.getElementById("cmdk") as HTMLDialogElement | null;
        // Same (persisted) dialog as before: already wired
        if (!current || current === dialog) return;

        dialog = current;
        input = dialog.querySelector("#cmdkInput")!;
        empty = dialog.querySelector("#cmdkEmpty")!;
        groups = Array.from(dialog.querySelectorAll<HTMLElement>(".cmdk-group"));
        options = Array.from(dialog.querySelectorAll<HTMLElement>("[role='option']"));
        activeIndex = -1;

        input.addEventListener("input", () => filter(input.value));

        input.addEventListener("keydown", (event) => {
            if (event.key === "ArrowDown") {
                event.preventDefault();
                setActive(activeIndex + 1);
            } else if (event.key === "ArrowUp") {
                event.preventDefault();
                setActive(activeIndex - 1);
            } else if (event.key === "Enter") {
                event.preventDefault();
                run(visibleOptions()[activeIndex]);
            }
        });

        options.forEach((option) => {
            option.addEventListener("mousemove", () => {
                const index = visibleOptions().indexOf(option);
                if (index !== activeIndex) setActive(index);
            });
            option.addEventListener("click", () => run(option));
        });

        // Clicking the backdrop (outside the panel) closes it
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) close();
        });
    }

    setup();

    document.addEventListener("astro:page-load", () => {
        setup();

        // Show ⌘K on Apple devices; runs on every page since the dock is re-rendered
        if (!isMac) return;
        document.querySelectorAll("[data-cmdk-shortcut]").forEach((el) => {
            el.textContent = "⌘K";
        });
    });
</script>
