---
// Home projects: a list of "mission files" and a hologram that shows the
// selected one. Every project is rendered on the server (so it works without
// JavaScript and is indexable); the script only decides which one is visible.
import { Image } from "astro:assets";
import SectionTag from "@/components/ui/section-tag.astro";
import { getProjects, categoryLabels, projectTransition } from "@/data/projects";
import { useTranslations, localizePath } from "@/i18n";

const __ = useTranslations(Astro.currentLocale);
const projects = await getProjects();

const pad = (n: number) => String(n).padStart(2, "0");
---

<section id="projects" class="relative pt-37.5 max-lg:pt-27.5" aria-labelledby="projects-heading">
    <div class="wrap">
        <SectionTag index="02" label={__("Projects")} aside={__("Holotable · :count files", { count: projects.length })} />

        <div class="mt-7.5 grid items-end gap-10 lg:grid-cols-[1fr_auto]">
            <h2 id="projects-heading" class="rv text-[clamp(38px,5.6vw,82px)] font-black leading-[0.94] tracking-[0.005em] uppercase">
                {__("Mission")}<br /><span class="hollow">{__("files.")}</span>
            </h2>

            <p class="rv max-w-125 font-light text-ink/70" style="--d: 0.1s">
                {__("A selection of products and platforms I've helped build. Pick a file and hover over the hologram to stabilize the signal.")}
            </p>
        </div>

        <div id="holotable" class="mt-15 grid items-center gap-11 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:gap-16">
            <ol class="rv" aria-label={__("Projects")}>
                {projects.map(({ id, data: project }, i) => (
                    <li class="first:border-t first:border-white/10">
                        <button
                            type="button"
                            data-file={id}
                            aria-pressed={i === 0 ? "true" : "false"}
                            style={`--c: ${project.accent}`}
                            class="group/file relative grid w-full cursor-pointer grid-cols-[44px_1fr_auto] items-center gap-3.5 max-sm:grid-cols-[28px_1fr] max-sm:gap-x-2.5 max-sm:gap-y-1 border-b border-white/10 py-4.75 pr-3.5 text-left text-muted transition-[color,padding,background] duration-400 ease-saga before:absolute before:inset-y-[-1px] before:left-0 before:w-0.5 before:bg-saga before:opacity-0 before:shadow-[0_0_14px_var(--color-saga)] before:transition-opacity aria-pressed:bg-linear-to-r aria-pressed:from-saga/12 aria-pressed:to-transparent aria-pressed:to-70% aria-pressed:pl-4 aria-pressed:before:opacity-100"
                        >
                            <span class="mono max-sm:row-span-2">{pad(i + 1)}</span>

                            <b class="text-[22px] font-black tracking-[0.05em] uppercase text-ink/70 transition-colors group-hover/file:text-ink group-aria-pressed/file:text-saga max-sm:text-lg">
                                {project.name}
                            </b>

                            <small class="mono flex items-center gap-2 text-[10px] tracking-[0.12em] max-sm:col-start-2">
                                <i class="size-1.5 rounded-full bg-(--c)"></i>
                                {__(categoryLabels[project.category])}
                            </small>
                        </button>
                    </li>
                ))}
            </ol>

            <!-- Hover tilts the hologram toward the cursor (desktop only) -->
            <div class="rv perspective-[1400px] pt-1.5" style="--d: 0.12s" data-stage>
                <div
                    data-card
                    class="relative animate-flicker rounded-md border border-holo/45 bg-linear-to-b from-holo/10 to-holo/3 p-5 shadow-[0_0_70px_-14px_color-mix(in_srgb,var(--color-holo)_60%,transparent),inset_0_0_50px_-24px_var(--color-holo)] transition-[transform,border-color,box-shadow] duration-500 ease-saga lg:transform-[rotateY(var(--ry,-8deg))_rotateX(var(--rx,3deg))] motion-reduce:animate-none after:pointer-events-none after:absolute after:inset-0 after:rounded-[inherit] after:bg-[repeating-linear-gradient(to_bottom,rgb(0_0_0/0.34)_0_1px,transparent_1px_3px)] after:mix-blend-multiply"
                >
                    {projects.map(({ id, data: project, }, i) => (
                        <div
                            data-panel={id}
                            hidden={i !== 0}
                            class="transition-[opacity,filter] duration-300 data-swapping:opacity-0 data-swapping:blur-lg"
                        >
                            <header class="mono flex justify-between text-holo/70">
                                <span>{__("File")} {pad(i + 1)} / {pad(projects.length)}</span>
                                <span>{__(categoryLabels[project.category])}</span>
                            </header>

                            <a
                                href={project.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="group/shot relative isolate mt-3.5 block aspect-video overflow-hidden border border-holo/40 bg-black"
                            >
                                {project.images[0] && (
                                    <Image
                                        src={project.images[0]}
                                        alt={`${__("Screenshot of")} ${project.name}`}
                                        widths={[480, 800, 1100]}
                                        sizes="(min-width: 1024px) 560px, 90vw"
                                        loading="lazy"
                                        class="absolute inset-0 size-full object-cover object-top brightness-110 contrast-125 grayscale transition-[filter] duration-600 ease-saga group-hover/shot:brightness-100 group-hover/shot:contrast-100 group-hover/shot:grayscale-0"
                                    />
                                )}

                                <span aria-hidden="true" class="absolute inset-0 bg-holo mix-blend-multiply saturate-120 transition-opacity duration-600 ease-saga group-hover/shot:opacity-0"></span>
                                <span aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-[30%] h-[28%] animate-scan bg-linear-to-b from-transparent via-white/20 to-transparent motion-reduce:hidden"></span>
                                <span class="sr-only">{__("(opens in a new tab)")}</span>
                            </a>

                            <h3
                                class="mt-5 text-[40px] font-black leading-none tracking-[0.04em] uppercase text-holo-soft [text-shadow:0_0_24px_color-mix(in_srgb,var(--color-holo)_70%,transparent)] max-sm:text-3xl"
                                transition:name={projectTransition(id).title}
                            >
                                {project.name}
                            </h3>

                            <p class="mt-2.5 min-h-[6.2em] text-[15px] font-light text-[color-mix(in_srgb,var(--color-holo)_55%,#fff)]">
                                {__(project.description)}
                            </p>

                            <ul class="mt-3 flex min-h-13.5 flex-wrap content-start gap-1.5" aria-label={__("Stack")}>
                                {project.stack.map((tech) => (
                                    <li class="chip border-holo/40 text-holo-soft">{tech}</li>
                                ))}
                            </ul>

                            <footer class="mt-3.5 flex items-center justify-between gap-3.5 border-t border-holo/28 pt-4">
                                <a href={localizePath(`/projects/${id}`, Astro.currentLocale)} class="btn btn-holo">
                                    {__("View case study")} →
                                </a>

                                <span class="mono text-holo/60 max-sm:hidden">{__("Holographic signal · live")}</span>
                            </footer>
                        </div>
                    ))}
                </div>

                <!-- Projector under the hologram -->
                <div aria-hidden="true" class="mx-auto h-21 w-3/4 bg-linear-to-t from-holo/45 to-transparent opacity-75 [clip-path:polygon(0_0,100%_0,57%_100%,43%_100%)]"></div>
                <div aria-hidden="true" class="relative mx-auto -mt-2.5 h-6.5 w-37.5 rounded-full bg-[radial-gradient(closest-side,#fff_0%,var(--color-holo)_42%,transparent_100%)] shadow-[0_0_46px_4px_color-mix(in_srgb,var(--color-holo)_70%,transparent)] after:absolute after:-inset-x-11.5 after:-inset-y-2 after:rounded-full after:border after:border-holo/40"></div>
            </div>
        </div>
    </div>
</section>

<script>
    function init() {
        const root = document.getElementById("holotable");
        if (!root) return;

        const files = [...root.querySelectorAll<HTMLButtonElement>("[data-file]")];
        const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
        const card = root.querySelector<HTMLElement>("[data-card]")!;
        const stage = root.querySelector<HTMLElement>("[data-stage]")!;
        const reduced = matchMedia("(prefers-reduced-motion: reduce)");

        let selected = files[0]?.dataset.file;
        let swapTimer: ReturnType<typeof setTimeout>;

        function show(id: string) {
            files.forEach((file) => file.setAttribute("aria-pressed", String(file.dataset.file === id)));
            panels.forEach((panel) => {
                panel.hidden = panel.dataset.panel !== id;
                panel.removeAttribute("data-swapping");
            });
        }

        function select(id: string) {
            if (id === selected) return;
            selected = id;
            files.forEach((file) => file.setAttribute("aria-pressed", String(file.dataset.file === id)));

            clearTimeout(swapTimer);
            if (reduced.matches) return show(id);

            // Blur the current file out, then swap and bring the new one in
            panels.find((panel) => !panel.hidden)?.setAttribute("data-swapping", "");
            swapTimer = setTimeout(() => show(id), 280);
        }

        files.forEach((file) => file.addEventListener("click", () => select(file.dataset.file!)));

        stage.addEventListener("pointermove", (event) => {
            if (reduced.matches) return;
            const box = stage.getBoundingClientRect();
            const x = (event.clientX - box.left) / box.width - 0.5;
            const y = (event.clientY - box.top) / box.height - 0.5;
            card.style.setProperty("--ry", `${(x * 12).toFixed(2)}deg`);
            card.style.setProperty("--rx", `${(-y * 8).toFixed(2)}deg`);
        });

        stage.addEventListener("pointerleave", () => {
            card.style.removeProperty("--ry");
            card.style.removeProperty("--rx");
        });
    }

    document.addEventListener("astro:page-load", init);
</script>
