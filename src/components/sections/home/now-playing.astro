---
// Live "now playing" line fed by /api/now-playing. Hidden until there is data,
// so it never shows up empty (or at all, if Spotify isn't configured).
import { useTranslations } from "@/i18n";

const __ = useTranslations(Astro.currentLocale);
---

<a
    id="nowPlaying"
    hidden
    target="_blank"
    rel="noopener noreferrer"
    data-now-playing={__("Now playing")}
    data-last-played={__("Last played")}
    class="group flex flex-col items-end gap-1.5 transition-colors duration-300 hover:text-ink/70"
>
    <span class="flex items-center gap-2">
        <!-- Equalizer bars, only while a track is playing -->
        <span class="hidden group-data-playing:flex items-end gap-0.5 h-2.5" aria-hidden="true">
            <span class="w-0.5 h-full rounded-full bg-saga origin-bottom animate-equalizer motion-reduce:animate-none"></span>
            <span class="w-0.5 h-full rounded-full bg-saga origin-bottom animate-equalizer [animation-delay:-0.4s] motion-reduce:animate-none"></span>
            <span class="w-0.5 h-full rounded-full bg-saga origin-bottom animate-equalizer [animation-delay:-0.7s] motion-reduce:animate-none"></span>
        </span>

        <span data-np="status">{__("Last played")}</span>
        <span aria-hidden="true">· Spotify</span>
    </span>

    <span>
        <b data-np="title" class="font-medium text-ink"></b>
        — <span data-np="artist"></span>
    </span>

    <span class="sr-only">{__("(opens in a new tab)")}</span>
</a>

<script>
    import type { NowPlaying } from "@/pages/api/now-playing";

    const REFRESH_MS = 30_000;
    let timer: ReturnType<typeof setInterval> | undefined;

    async function update() {
        const link = document.getElementById("nowPlaying") as HTMLAnchorElement | null;
        if (!link || document.hidden) return;

        try {
            const response = await fetch("/api/now-playing");
            const track: NowPlaying | null = response.ok ? await response.json() : null;
            if (!track) return;

            const field = (name: string) => link.querySelector<HTMLElement>(`[data-np="${name}"]`)!;

            link.href = track.url;
            field("title").textContent = track.title;
            field("artist").textContent = track.artist;
            field("status").textContent = track.isPlaying ? link.dataset.nowPlaying! : link.dataset.lastPlayed!;
            link.toggleAttribute("data-playing", track.isPlaying);
            link.hidden = false;
        } catch {
            // Offline or API down: keep whatever is shown (or stay hidden)
        }
    }

    document.addEventListener("astro:page-load", () => {
        clearInterval(timer);
        if (!document.getElementById("nowPlaying")) return;

        update();
        timer = setInterval(update, REFRESH_MS);
    });

    // Refresh right away when coming back to the tab
    document.addEventListener("visibilitychange", update);
</script>
