---
// Carlos's local time, plus how it compares to the visitor's.
// The page is static, so the time is filled in by the browser;
// until then (or without JS) it just shows the city.
import { useTranslations, getLocale, localeCodes } from "@/i18n";

const TIME_ZONE = "America/Bogota";

const locale = getLocale(Astro.currentLocale);
const __ = useTranslations(locale);
---

<span
    id="localTime"
    data-time-zone={TIME_ZONE}
    data-locale={localeCodes[locale]}
    data-same={__("· same time as you")}
    data-ahead={__("· :hours ahead of you")}
    data-behind={__("· :hours behind you")}
    class="row items-center gap-1.5 text-sm text-white/60"
>
    <time data-lt="time" class="font-semibold text-white tabular-nums">{__("Local time")}</time>
    <span>{__("in Barranquilla")}</span>
    <span data-lt="diff" class="hidden sm:inline text-white/50"></span>
</span>

<script>
    let timer: ReturnType<typeof setTimeout> | undefined;

    // Hours between two time zones at this moment (handles DST on the visitor's side)
    function offsetHours(timeZone: string, now: Date) {
        const local = new Date(now.toLocaleString("en-US", { timeZone }));
        const visitor = new Date(now.toLocaleString("en-US"));
        // Rounded to half hours: some zones (India, Newfoundland…) are offset by :30
        return Math.round(((local.getTime() - visitor.getTime()) / 36e5) * 2) / 2;
    }

    // The sentences come translated in the data-* attributes
    function describe(hours: number, texts: DOMStringMap) {
        if (hours === 0) return texts.same!;
        const sentence = hours > 0 ? texts.ahead! : texts.behind!;
        return sentence.replace(":hours", `${Math.abs(hours)}h`);
    }

    function update() {
        const root = document.getElementById("localTime");
        if (!root) return;

        const timeZone = root.dataset.timeZone!;
        const now = new Date();

        const time = root.querySelector<HTMLTimeElement>("[data-lt='time']")!;
        time.textContent = now.toLocaleTimeString(root.dataset.locale, { timeZone, hour: "numeric", minute: "2-digit" });
        time.dateTime = now.toISOString();

        root.querySelector("[data-lt='diff']")!.textContent = describe(offsetHours(timeZone, now), root.dataset);

        // Tick right when the next minute starts
        timer = setTimeout(update, 60_000 - (now.getTime() % 60_000));
    }

    document.addEventListener("astro:page-load", () => {
        clearTimeout(timer);
        update();
    });
</script>
