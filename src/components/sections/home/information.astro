---
import Card from "@/components/ui/card.astro";
import IconSuitcase from "@/components/icons/icon-suitcase.astro";
import IconDownload from "@/components/icons/icon-download.astro";
import IconStart from "@/components/icons/icon-start.astro";
import IconProjects from "@/components/icons/icon-projects.astro";
import IconContact from "@/components/icons/icon-contact.astro";
import Disk from "@/components/ui/disk.astro";

import { jobsInformation as jobs } from "@/constants/home";
import { iconsSkills as skills } from "@/constants/home";
import { projects } from "@/constants/home";
import IconArrowUpRight from "@/components/icons/icon-arrow-up-right.astro";
---

<section class="size-screen py-25 col gap-5">
    <div class="grid lg:grid-cols-2 gap-5">
        <!-- Skills -->
        <Card
            title="Skills"
            component={IconStart}
        >
            <div slot="content" class="center-content col gap-4">
                {Array.from({ length: 3 }).map((_, i) => (
                   <div class="center-content gap-4">
                        {skills
                            .filter(skill => skill.position === i)
                            .map(({ icon: Icon, color }) => (
                                <div class="center-content gap-4">
                                    <div class={`box-gen size-15 center-content ${color}`}>
                                        <Icon class="size-5" />
                                    </div>
                                </div>
                            ))
                        }
                    </div> 
                ))}
            </div>
        </Card>

        <!-- Experience -->
        <Card
            title="Experience"
            component={IconSuitcase}
            overflow={false}
            footerContent={true}
        >
            <div slot="content" class="h-46 pr-4">
                {jobs.map(( item ) => (
                    <div class="row items-center justify-between py-4">
                        <div class="row items-center gap-2.5">
                            <img 
                                src={item.logo} 
                                alt={item.company}
                                width="32"
                                height="32"
                                loading="lazy" 
                                class="rounded-lg"
                            />

                            <h2>
                                <span class="font-medium">
                                    {item.company}
                                </span>

                                <span class="ml-2 text-xs text-[#a0a0a0]">
                                    {item.role}
                                </span> 
                            </h2>
                        </div>

                        <span class="text-xs text-[#a0a0a0]">
                            {item.period}
                        </span>
                    </div>
                ))}
            </div>

            <div slot="footer" class="w-full mt-4">
                <button class="button-main">
                    <IconDownload class="size-4 stroke-zinc-400" />

                    <span class="text-sm">Download CV</span>
                </button>
            </div>
        </Card>
    </div>

    <div class="grid lg:grid-cols-3 gap-5">
        <!-- Projects -->
        <Card
            title="Projects"
            component={IconProjects}
            overflow={false}
        >
            <div slot="content" class="h-54 col gap-3 pr-3">
                {projects.map(( project ) => (
                    <a
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group box-gen p-3 col gap-2 transition-all duration-300 hover:border-white/20!"
                    >
                        <div class="row items-center justify-between gap-2">
                            <h2 class="font-medium text-sm group-hover:text-white">
                                {project.name}
                            </h2>

                            <span class="stroke-[#a0a0a0] transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:stroke-white">
                                <IconArrowUpRight class="size-3" />
                            </span>
                        </div>

                        <p class="text-xs text-[#a0a0a0] leading-snug">
                            {project.description}
                        </p>

                        <div class="row flex-wrap gap-1.5 mt-1">
                            {project.stack.map(( tech ) => (
                                <span class="box-gen rounded-full! text-[10px] text-[#a0a0a0] py-0.5 px-2">
                                    {tech}
                                </span>
                            ))}
                        </div>
                    </a>
                ))}
            </div>
        </Card>

        <div class="col gap-5">
            <!-- Tracks -->
            <Card 
                headerContent={false}
                height="h-[30%]"
            >
                <div slot="content" class="row gap-5 items-center">
                    <Disk 
                        id="diskImg"
                        src="/images/music/airbag.jpg" 
                        alt="Cover"
                    />

                    <div class="col w-1/2">
                        <p id="trackTitle" class="truncate font-semibold text-sm"></p>
                        <p id="trackArtist" class="truncate text-xs opacity-50"></p>

                        <div class="row gap-3 items-center mt-1">
                            <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/10">
                                <div id="progress" class="h-full w-0 bg-white/50"></div>
                            </div>
    
                            <span id="time" class="text-right text-[11px] tabular-nums text-white/70">0:00</span>
                        </div>
                    </div>

                    <div class="row gap-2">
                        <button
                            id="playBtn"
                            type="button" 
                            class="size-8! center-content button-main"
                            aria-label="Play"
                        >
                            <span id="playIcon">▶</span>
                        </button>

                        <button
                            id="nextBtn"
                            type="button"
                            class="size-8! center-content button-main"
                            aria-label="Next"
                        >
                            |▶
                        </button>
                    </div>
                </div>
            </Card>

            <!-- Contact -->
            <Card 
                title="Contact"
                component={IconContact}
                height="h-[70%]"
            >
                <div slot="content" class="col">
                    <p class="text-sm text-[#a0a0a0]">
                        Creating unique digital experiences. <br>
                        Let's talk about your next project!
                    </p>

                    <a href="mailto:mazagonzalez@gmail.com" class="button-main mt-8">
                        Send an Email
                    </a>
                </div>
            </Card>
        </div>

        <!-- Character (Rengoku) -->
        <Card
            headerContent={false}
            overflow={false}
        >
        
        </Card>
    </div>
</section>
