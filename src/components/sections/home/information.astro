---
import Card from "@/components/ui/card.astro";
import IconSuitcase from "@/components/icons/icon-suitcase.astro";
import IconDownload from "@/components/icons/icon-download.astro";
import IconContact from "@/components/icons/icon-contact.astro";
import IconEmail from "@/components/icons/icon-email.astro";
import IconCopy from "@/components/icons/icon-copy.astro";

import { experience } from "@/data/experience";
import { email } from "@/data/social";
import { useTranslations, localizePath } from "@/i18n";

const __ = useTranslations(Astro.currentLocale);
---

<div class="size-screen py-25 col gap-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- Experience -->
        <Card
            title={__("Experience")}
            component={IconSuitcase}
            overflow={false}
            footerContent={true}
        >
            <ul slot="content" class="h-46 pr-4">
                {experience.map(( item ) => {
                    const [start, end] = item.period.split(" - ");
                    const endIsYear = !Number.isNaN(Number(end));

                    return (
                        <li class="row items-center justify-between gap-3 py-4">
                            <div class="row items-center gap-2.5 min-w-0">
                                <img
                                    src={item.logo}
                                    alt=""
                                    width="32"
                                    height="32"
                                    loading="lazy"
                                    class="size-8 shrink-0 rounded-lg"
                                />

                                <p>
                                    <span class="font-medium">
                                        {item.company}
                                    </span>
                                    {" "}
                                    <span class="block lg:inline lg:ml-2 text-xs text-muted">
                                        {__(item.role)}
                                    </span>
                                </p>
                            </div>

                            <span class="shrink-0 text-xs text-muted">
                                <time datetime={start}>{start}</time>
                                {" - "}
                                {endIsYear ? <time datetime={end}>{end}</time> : __(end)}
                            </span>
                        </li>
                    );
                })}
            </ul>

            <div slot="footer" class="w-full mt-4">
                <a href="/Carlos-Maza-CV.pdf" download class="button-main">
                    <IconDownload class="size-4 stroke-zinc-400" />

                    <span class="text-sm">{__("Download CV")}</span>
                </a>
            </div>
        </Card>

        <!-- Contact -->
        <Card
            title={__("Contact")}
            component={IconContact}
        >
            <p slot="header-extra" class="text-xs text-white/50">
                {__("Replies within :time", { time: "24h" })}
            </p>

            <div slot="content" class="col">
                <p class="text-sm text-muted">
                    {__("Creating unique digital experiences.")} <br>
                    {__("Let's talk about your next project!")}
                </p>

                <!-- mailto does nothing without a mail app, so the address can also be copied -->
                <div class="row gap-2 mt-8">
                    <a href={`mailto:${email}`} class="button-main">
                        <IconEmail class="size-4 stroke-zinc-400" />

                        <span class="text-sm">{__("Send an email")}</span>
                    </a>

                    <button
                        type="button"
                        id="copyEmail"
                        data-email={email}
                        data-copied={__("Copied!")}
                        data-copy-failed={__("Couldn't copy")}
                        title={email}
                        class="button-main"
                    >
                        <IconCopy class="size-4 stroke-zinc-400" />

                        <span class="text-sm" aria-live="polite">{__("Copy email")}</span>
                    </button>
                </div>
            </div>
        </Card>
    </div>
</div>

<script>
    import { copyText } from "@/scripts/clipboard";

    document.addEventListener("astro:page-load", () => {
        const button = document.getElementById("copyEmail");
        const label = button?.querySelector("span");
        if (!button || !label) return;

        const original = label.textContent;
        let timer: ReturnType<typeof setTimeout>;

        button.addEventListener("click", async () => {
            const copied = await copyText(button.dataset.email!);
            label.textContent = copied ? button.dataset.copied! : button.dataset.copyFailed!;

            clearTimeout(timer);
            timer = setTimeout(() => (label.textContent = original), 2000);
        });
    });
</script>
