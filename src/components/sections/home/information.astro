---
import Card from "@/components/ui/card.astro";
import IconSuitcase from "@/components/icons/icon-suitcase.astro";
import IconDownload from "@/components/icons/icon-download.astro";
import IconStart from "@/components/icons/icon-start.astro";
import IconProjects from "@/components/icons/icon-projects.astro";
import IconContact from "@/components/icons/icon-contact.astro";
import IconArrowUpRight from "@/components/icons/icon-arrow-up-right.astro";
import IconEmail from "@/components/icons/icon-email.astro";
import IconCopy from "@/components/icons/icon-copy.astro";

import { experience } from "@/data/experience";
import { featuredSkills } from "@/data/skills";
import { getProjects, projectTransition } from "@/data/projects";
import { email } from "@/data/social";
import { useTranslations, localizePath } from "@/i18n";

const __ = useTranslations(Astro.currentLocale);
const projects = await getProjects();
---

<div class="size-screen py-25 col gap-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- Skills -->
        <Card
            title={__("Skills")}
            link={localizePath("/skills", Astro.currentLocale)}
            component={IconStart}
        >
            <!-- Icons are sized for the widest row (5) so they all shrink together on small screens -->
            <div slot="content" class="center-content col gap-2 sm:gap-4" aria-hidden="true">
                {featuredSkills.map((row) => (
                    <div class="w-full center-content gap-2 sm:gap-4">
                        {row.map(({ icon: Icon, accent }) => (
                            <div class={`box-gen aspect-square w-[calc((100%-2rem)/5)] sm:w-[calc((100%-4rem)/5)] max-w-15 center-content ${accent}`}>
                                <Icon class="size-5" />
                            </div>
                        ))}
                    </div>
                ))}
            </div>
        </Card>

        <!-- Experience -->
        <Card
            title={__("Experience")}
            component={IconSuitcase}
            overflow={false}
            footerContent={true}
        >
            <ul slot="content" class="h-46 pr-4">
                {experience.map(( item ) => {
                    const [start, end] = item.period.split(" - ");
                    const endIsYear = !Number.isNaN(Number(end));

                    return (
                        <li class="row items-center justify-between gap-3 py-4">
                            <div class="row items-center gap-2.5 min-w-0">
                                <img
                                    src={item.logo}
                                    alt=""
                                    width="32"
                                    height="32"
                                    loading="lazy"
                                    class="size-8 shrink-0 rounded-lg"
                                />

                                <p>
                                    <span class="font-medium">
                                        {item.company}
                                    </span>
                                    {" "}
                                    <span class="block lg:inline lg:ml-2 text-xs text-muted">
                                        {__(item.role)}
                                    </span>
                                </p>
                            </div>

                            <span class="shrink-0 text-xs text-muted">
                                <time datetime={start}>{start}</time>
                                {" - "}
                                {endIsYear ? <time datetime={end}>{end}</time> : __(end)}
                            </span>
                        </li>
                    );
                })}
            </ul>

            <div slot="footer" class="w-full mt-4">
                <a href="/Carlos-Maza-CV.pdf" download class="button-main">
                    <IconDownload class="size-4 stroke-zinc-400" />

                    <span class="text-sm">{__("Download CV")}</span>
                </a>
            </div>
        </Card>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- Projects -->
        <Card
            title={__("Projects")}
            component={IconProjects}
            overflow={false}
        >
            <ul slot="content" class="h-54 col gap-3 pr-3">
                {projects.map(({ id, data: project }) => (
                    <li>
                        <a
                            href={localizePath(`/projects/${id}`, Astro.currentLocale)}
                            class="group box-gen p-3 col gap-2 transition-all duration-300 hover:border-white/20!"
                        >
                            <div class="row items-center justify-between gap-2">
                                <h3 class="font-medium text-sm group-hover:text-white w-fit" transition:name={projectTransition(id).title}>
                                    {project.name}
                                </h3>

                                <span class="stroke-muted transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:stroke-white">
                                    <IconArrowUpRight class="size-3" />
                                </span>
                            </div>

                            <p class="text-xs text-muted leading-snug">
                                {__(project.description)}
                            </p>

                            <ul class="row flex-wrap gap-1.5 mt-1" aria-label={__("Stack")}>
                                {project.stack.map(( tech ) => (
                                    <li class="box-gen rounded-full! text-[10px] text-muted py-0.5 px-2">
                                        {tech}
                                    </li>
                                ))}
                            </ul>
                        </a>
                    </li>
                ))}
            </ul>
        </Card>

        <!-- Contact -->
        <Card
            title={__("Contact")}
            component={IconContact}
        >
            <p slot="header-extra" class="text-xs text-white/50">
                {__("Replies within :time", { time: "24h" })}
            </p>

            <div slot="content" class="col">
                <p class="text-sm text-muted">
                    {__("Creating unique digital experiences.")} <br>
                    {__("Let's talk about your next project!")}
                </p>

                <!-- mailto does nothing without a mail app, so the address can also be copied -->
                <div class="row gap-2 mt-8">
                    <a href={`mailto:${email}`} class="button-main">
                        <IconEmail class="size-4 stroke-zinc-400" />

                        <span class="text-sm">{__("Send an email")}</span>
                    </a>

                    <button
                        type="button"
                        id="copyEmail"
                        data-email={email}
                        data-copied={__("Copied!")}
                        data-copy-failed={__("Couldn't copy")}
                        title={email}
                        class="button-main"
                    >
                        <IconCopy class="size-4 stroke-zinc-400" />

                        <span class="text-sm" aria-live="polite">{__("Copy email")}</span>
                    </button>
                </div>
            </div>
        </Card>
    </div>
</div>

<script>
    import { copyText } from "@/scripts/clipboard";

    document.addEventListener("astro:page-load", () => {
        const button = document.getElementById("copyEmail");
        const label = button?.querySelector("span");
        if (!button || !label) return;

        const original = label.textContent;
        let timer: ReturnType<typeof setTimeout>;

        button.addEventListener("click", async () => {
            const copied = await copyText(button.dataset.email!);
            label.textContent = copied ? button.dataset.copied! : button.dataset.copyFailed!;

            clearTimeout(timer);
            timer = setTimeout(() => (label.textContent = original), 2000);
        });
    });
</script>
