---
import Card from "@/components/ui/card.astro";
import IconSuitcase from "@/components/icons/icon-suitcase.astro";
import IconDownload from "@/components/icons/icon-download.astro";
import IconStart from "@/components/icons/icon-start.astro";
import IconProjects from "@/components/icons/icon-projects.astro";
import IconContact from "@/components/icons/icon-contact.astro";
import IconArrowUpRight from "@/components/icons/icon-arrow-up-right.astro";
import Hyperspace from "@/components/backgrounds/hyperspace.jsx";
import MusicPlayer from "@/components/music/music-player.astro";

import { experience } from "@/data/experience";
import { featuredSkills } from "@/data/skills";
import { getProjects, projectTransition } from "@/data/projects";
import { email } from "@/data/social";

const projects = await getProjects();
---

<div class="size-screen py-25 col gap-5">
    <div class="grid md:grid-cols-2 gap-5">
        <!-- Skills -->
        <Card
            title="Skills"
            link="/skills"
            component={IconStart}
        >
            <div slot="content" class="center-content col gap-4" aria-hidden="true">
                {featuredSkills.map((row) => (
                    <div class="center-content gap-4">
                        {row.map(({ icon: Icon, accent }) => (
                            <div class={`box-gen size-15 center-content ${accent}`}>
                                <Icon class="size-5" />
                            </div>
                        ))}
                    </div>
                ))}
            </div>
        </Card>

        <!-- Experience -->
        <Card
            title="Experience"
            component={IconSuitcase}
            overflow={false}
            footerContent={true}
        >
            <ul slot="content" class="h-46 pr-4">
                {experience.map(( item ) => {
                    const [start, end] = item.period.split(" - ");
                    const endIsYear = !Number.isNaN(Number(end));

                    return (
                        <li class="row items-center justify-between py-4">
                            <div class="row items-center gap-2.5">
                                <img
                                    src={item.logo}
                                    alt=""
                                    width="32"
                                    height="32"
                                    loading="lazy"
                                    class="rounded-lg"
                                />

                                <p>
                                    <span class="font-medium">
                                        {item.company}
                                    </span>
                                    {" "}
                                    <span class="ml-2 text-xs text-muted">
                                        {item.role}
                                    </span>
                                </p>
                            </div>

                            <span class="text-xs text-muted">
                                <time datetime={start}>{start}</time>
                                {" - "}
                                {endIsYear ?<time datetime={end}>{end}</time> : end}
                            </span>
                        </li>
                    );
                })}
            </ul>

            <div slot="footer" class="w-full mt-4">
                <a href="/Carlos-Maza-CV.pdf" download class="button-main">
                    <IconDownload class="size-4 stroke-zinc-400" />

                    <span class="text-sm">Download CV</span>
                </a>
            </div>
        </Card>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Projects -->
        <Card
            title="Projects"
            component={IconProjects}
            overflow={false}
        >
            <ul slot="content" class="h-54 col gap-3 pr-3">
                {projects.map(({ id, data: project }) => (
                    <li>
                        <a
                            href={`/projects/${id}`}
                            class="group box-gen p-3 col gap-2 transition-all duration-300 hover:border-white/20!"
                        >
                            <div class="row items-center justify-between gap-2">
                                <h3 class="font-medium text-sm group-hover:text-white w-fit" transition:name={projectTransition(id).title}>
                                    {project.name}
                                </h3>

                                <span class="stroke-muted transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:stroke-white">
                                    <IconArrowUpRight class="size-3" />
                                </span>
                            </div>

                            <p class="text-xs text-muted leading-snug">
                                {project.description}
                            </p>

                            <ul class="row flex-wrap gap-1.5 mt-1" aria-label="Stack">
                                {project.stack.map(( tech ) => (
                                    <li class="box-gen rounded-full! text-[10px] text-muted py-0.5 px-2">
                                        {tech}
                                    </li>
                                ))}
                            </ul>
                        </a>
                    </li>
                ))}
            </ul>
        </Card>

        <div class="col gap-5">
            <!-- Tracks -->
            <Card
                headerContent={false}
                height="h-[30%]"
            >
                <MusicPlayer slot="content" />
            </Card>

            <!-- Contact -->
            <Card
                title="Contact"
                component={IconContact}
                height="h-[70%]"
            >
                <p slot="header-extra" class="text-xs text-white/40">
                    Replies within 24h
                </p>

                <div slot="content" class="col">
                    <p class="text-sm text-muted">
                        Creating unique digital experiences. <br>
                        Let's talk about your next project!
                    </p>

                    <a href={`mailto:${email}`} class="button-main mt-8">
                        Send an Email
                    </a>
                </div>
            </Card>
        </div>

        <!-- Signature -->
        <div class="md:col-span-2 lg:col-span-1" aria-hidden="true">
            <Card
                headerContent={false}
                overflow={false}
            >
                <div slot="content" class="group relative h-68 w-full center-content overflow-hidden rounded-lg">
                    <Hyperspace client:only="react" />

                    <div class="relative col items-center gap-1 text-center pointer-events-none transition-opacity duration-300 group-hover:opacity-0">
                        <span class="text-2xl font-bold tracking-wide">AMG</span>
                        <span class="text-[10px] uppercase tracking-[0.2em] text-white/40">Hover to jump to lightspeed</span>
                    </div>

                    <!-- Easter egg hint: shows up once the stars reach lightspeed -->
                    <p class="absolute inset-x-0 bottom-5 text-center text-[11px] tracking-[0.35em] text-white/35 pointer-events-none opacity-0 blur-sm transition-all duration-700 group-hover:opacity-100 group-hover:blur-none group-hover:delay-700">
                        ↑ ↑ ↓ ↓ ← → ← → B A
                    </p>
                </div>
            </Card>
        </div>
    </div>
</div>
