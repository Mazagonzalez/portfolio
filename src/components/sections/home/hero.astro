---
import { socialLinks } from "@/data/social";
---

<section class="size-screen mt-32" aria-labelledby="hero-title">
    <div class="bg-zinc-800 rounded-full size-20" aria-hidden="true"></div>
    
    <div class="col gap-2 mt-3">
        <h1 id="hero-title" class="text-3xl font-bold">
            Hi, I am Carlos Maza
        </h1>

        <p class="text-white/80 font-light max-w-104 [&>strong]:font-bold">
            <strong>Frontend developer</strong> capable of creating, modifying
            and optimizing functions, ensuring high performance
            and <strong>an excellent user experience.</strong>
        </p>
    </div>

    <p class="box-gen w-fit mt-6 px-3 py-1 row gap-3 items-center">
        <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute size-full animate-ping rounded-full bg-lime-400/75"></span>
            <span class="relative size-full rounded-full bg-lime-500"></span>
        </span>

        <span class="text-sm font-semibold">
            Available for new projects
        </span>
    </p>

    <ul class="row items-center gap-7 mt-7" aria-label="Social links">
        {socialLinks.map(({ url, label, icon: Icon, target }) => (
            <li>
                <a 
                    href={url} 
                    target={target === false ? "_self" : "_blank"} 
                    rel="noopener noreferrer"
                    aria-label={label}
                >
                    <Icon class="icon" />
                </a>
            </li>
        ))}
    </ul>
</section>
