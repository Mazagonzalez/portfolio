---
// Project cover for the lists: the desktop screenshot peeks out of a browser
// frame over the brand color, with the phone screenshot on top of it
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import IconProjects from "@/components/icons/icon-projects.astro";

interface Props {
    image?: ImageMetadata;
    mobile?: ImageMetadata;
    accent: string;
    eager?: boolean;
    transitionName?: string;
}

const { image, mobile, accent, eager = false, transitionName } = Astro.props;
---

<div
    class="relative aspect-video overflow-hidden rounded-lg bg-[color-mix(in_oklab,var(--accent)_38%,#0f0f12)]"
    style={`--accent: ${accent}`}
    transition:name={transitionName}
>
    <div class="absolute inset-0 bg-[radial-gradient(130%_110%_at_0%_0%,var(--accent),transparent_70%)]"></div>

    {image ? (
        <>
            <div class="absolute left-[11%] top-[14%] w-full h-full overflow-hidden rounded-tl-md bg-[#18181b] outline outline-white/15 shadow-2xl shadow-black/50 transition-transform duration-500 group-hover:-translate-y-1.5">
                <div class="row items-center gap-1 h-[5%] min-h-2 px-[1.5%] bg-white/5 border-b border-white/10" aria-hidden="true">
                    <span class="size-1 rounded-full bg-white/25"></span>
                    <span class="size-1 rounded-full bg-white/25"></span>
                    <span class="size-1 rounded-full bg-white/25"></span>
                </div>
                <Image
                    src={image}
                    alt=""
                    widths={[480, 800, 1100]}
                    sizes="(min-width: 768px) 640px, 100vw"
                    loading={eager ? "eager" : "lazy"}
                    class="w-full h-auto"
                />
            </div>

            {mobile && (
                <div class="absolute right-[6%] -bottom-[18%] w-[17%] overflow-hidden rounded-[0.9rem] border-[3px] border-[#27272a] bg-black outline outline-white/15 shadow-2xl shadow-black/60 transition-transform duration-500 group-hover:-translate-y-3">
                    <Image
                        src={mobile}
                        alt=""
                        widths={[200, 400]}
                        sizes="(min-width: 768px) 120px, 17vw"
                        loading={eager ? "eager" : "lazy"}
                        class="w-full h-auto"
                    />
                </div>
            )}
        </>
    ) : (
        <div class="relative size-full center-content">
            <IconProjects class="size-8 stroke-white/15" />
        </div>
    )}
</div>
