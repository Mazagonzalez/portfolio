---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations } from "@/i18n";

interface Props {
    images: ImageMetadata[];
    alt: string;
}

const { images, alt } = Astro.props;
const __ = useTranslations(Astro.currentLocale);
---

<section class="col gap-5" aria-labelledby="mobile-title">
    <h2 id="mobile-title" class="text-xl font-semibold">{__("On mobile")}</h2>

    <!-- Scrolls sideways on small screens, one phone per swipe -->
    <ul class="row gap-5 overflow-x-auto snap-x snap-mandatory -mx-4 px-4 pb-2 md:mx-0 md:px-0 md:overflow-visible">
        {images.map((src, i) => (
            <li class="snap-center shrink-0 w-[62%] sm:w-[40%] md:w-auto md:flex-1 md:max-w-64">
                <div class="overflow-hidden rounded-[2rem] border-[6px] border-[#27272a] bg-black outline outline-white/10 shadow-2xl shadow-black/40">
                    <Image
                        src={src}
                        alt={__(":name — mobile screenshot :number of :total", { name: alt, number: i + 1, total: images.length })}
                        widths={[300, 600]}
                        sizes="(min-width: 768px) 256px, 62vw"
                        loading="lazy"
                        class="w-full h-auto"
                    />
                </div>
            </li>
        ))}
    </ul>
</section>
