---
import IconChevronLeft from "@/components/icons/icon-chevron-left.astro";
import IconChevronRight from "@/components/icons/icon-chevron-right.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { useTranslations } from "@/i18n";

interface Props {
    images?: ImageMetadata[];
    alt?: string;
    transitionName?: string;
}

const { images = [], alt = "", transitionName } = Astro.props;
const __ = useTranslations(Astro.currentLocale);
---

<section class="col gap-3" aria-roledescription="carousel" aria-label={__(":name screenshots", { name: alt })}>
    <div class="box-gen relative aspect-video overflow-hidden" transition:name={transitionName}>
        {images.length > 0 ? (
            <>
                <div id="carouselTrack" class="row h-full transition-transform duration-500 ease-out">
                    {images.map((src, i) => (
                        <Image
                            src={src}
                            alt={__(":name — screenshot :number of :total", { name: alt, number: i + 1, total: images.length })}
                            aria-hidden={i === 0 ? undefined : "true"}
                            widths={[640, 1100, 1920]}
                            sizes="(min-width: 1100px) 1100px, 100vw"
                            loading={i === 0 ? "eager" : "lazy"}
                            class="h-full w-full shrink-0 object-cover"
                        />
                    ))}
                </div>

                {images.length > 1 && (
                    <>
                        <button
                            id="carouselPrev"
                            type="button"
                            aria-label={__("Previous image")}
                            class="absolute-center-y left-3 size-9 center-content rounded-full bg-black/50 backdrop-blur border border-white/10 hover:bg-black/70 transition-colors cursor-pointer"
                        >
                            <IconChevronLeft class="size-4" />
                        </button>

                        <button
                            id="carouselNext"
                            type="button"
                            aria-label={__("Next image")}
                            class="absolute-center-y right-3 size-9 center-content rounded-full bg-black/50 backdrop-blur border border-white/10 hover:bg-black/70 transition-colors cursor-pointer"
                        >
                            <IconChevronRight class="size-4" />
                        </button>
                    </>
                )}
            </>
        ) : (
            <div class="size-full center-content">
                <p class="text-sm text-muted">{__("Preview images coming soon.")}</p>
            </div>
        )}
    </div>

    {images.length > 1 && (
        <div id="carouselDots" role="group" aria-label={__("Choose screenshot")} class="row justify-center">
            {images.map((_, i) => (
                <button
                    type="button"
                    data-index={i}
                    aria-label={__("Go to image :number", { number: i + 1 })}
                    aria-current={i === 0 ? "true" : undefined}
                    class="size-6 center-content cursor-pointer before:size-1.5 before:rounded-full before:bg-white/20 before:transition-colors hover:before:bg-white/40 aria-[current=true]:before:bg-white/70"
                ></button>
            ))}
        </div>
    )}
</section>

<script>
    document.addEventListener("astro:page-load", () => {
        const track = document.getElementById("carouselTrack");
        const prevBtn = document.getElementById("carouselPrev");
        const nextBtn = document.getElementById("carouselNext");
        const dots = document.querySelectorAll<HTMLButtonElement>("#carouselDots button");

        if (track && dots.length > 0) {
            let index = 0;

            const goTo = (i: number) => {
                index = (i + dots.length) % dots.length;
                track.style.transform = `translateX(-${index * 100}%)`;

                Array.from(track.children).forEach((img, ii) => {
                    if (ii === index) img.removeAttribute("aria-hidden");
                    else img.setAttribute("aria-hidden", "true");
                });

                dots.forEach((dot, di) => {
                    if (di === index) dot.setAttribute("aria-current", "true");
                    else dot.removeAttribute("aria-current");
                });
            };

            // Swipe on touch screens
            let startX = 0;
            let startY = 0;

            track.addEventListener("touchstart", (event) => {
                startX = event.touches[0].clientX;
                startY = event.touches[0].clientY;
            }, { passive: true });

            track.addEventListener("touchend", (event) => {
                const dx = event.changedTouches[0].clientX - startX;
                const dy = event.changedTouches[0].clientY - startY;

                // Mostly horizontal and long enough, so vertical scrolling still works
                if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) goTo(index + (dx < 0 ? 1 : -1));
            });

            prevBtn?.addEventListener("click", () => goTo(index - 1));
            nextBtn?.addEventListener("click", () => goTo(index + 1));
            dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
        }
    });
</script>
