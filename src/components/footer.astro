---
import { iconsHero } from "@/constants/home";

const year = new Date().getFullYear();
---

<footer class="size-screen relative z-10 pb-10">
    <div class="col gap-6">
        <div class="row flex-wrap items-center justify-between gap-6">
            <div class="col gap-1">
                <p class="text-lg font-semibold">
                    Carlos Maza
                </p>

                <p class="text-sm text-[#a0a0a0]">
                    Frontend developer building fast, thoughtful web experiences.
                </p>
            </div>

            <ul class="row items-center gap-5" aria-label="Social links">
                {iconsHero.map(({ url, label, icon: Icon, target }) => (
                    <li>
                        <a
                            href={url}
                            target={target === false ? "_self" : "_blank"}
                            rel="noopener noreferrer"
                            aria-label={label}
                        >
                            <Icon class="icon" />
                        </a>
                    </li>
                ))}
            </ul>
        </div>

        <hr class="h-px w-full border-0 bg-white/10" />

        <p class="text-xs text-[#a0a0a0] text-end">
            <small class="text-xs">&copy; {year} Carlos Maza. All rights reserved.</small>
        </p>
    </div>
</footer>
