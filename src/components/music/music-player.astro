---
import Disk from "@/components/music/disk.astro";

import { tracks } from "@/data/tracks";
import { useTranslations } from "@/i18n";

const __ = useTranslations(Astro.currentLocale);
const labels = { play: __("Play"), pause: __("Pause") };
---

<section class="row gap-5 items-center" aria-labelledby="player-title">
    <h2 id="player-title" class="sr-only">{__("Music player")}</h2>

    <Disk
        id="diskImg"
        src={tracks[0].cover}
        alt=""
    />

    <div class="col w-1/2">
        <!-- 30s previews from Apple: each title links back to the song on Apple Music -->
        <a
            id="trackLink"
            target="_blank"
            rel="noopener noreferrer"
            title={__("Listen on Apple Music")}
            class="truncate font-semibold text-sm hover:underline underline-offset-2"
        >
            <span id="trackTitle"></span>
            <span class="sr-only">{__("(opens in a new tab)")}</span>
        </a>
        <p id="trackArtist" class="truncate text-xs opacity-50"></p>

        <div class="row gap-3 items-center mt-1">
            <div
                id="progressBar"
                role="progressbar"
                aria-label={__("Track progress")}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                class="h-1.5 w-full overflow-hidden rounded-full bg-white/10"
            >
                <div id="progress" class="h-full w-0 bg-white/50"></div>
            </div>

            <span id="time" class="text-right text-[11px] tabular-nums text-white/70">0:00</span>
        </div>
    </div>

    <div class="row gap-2">
        <button
            id="playBtn"
            type="button"
            class="size-8! center-content button-main"
            aria-label={labels.play}
        >
            <span id="playIcon" aria-hidden="true">▶</span>
        </button>

        <button
            id="nextBtn"
            type="button"
            class="size-8! center-content button-main"
            aria-label={__("Next track")}
        >
            <span aria-hidden="true">|▶</span>
        </button>
    </div>
</section>

<audio id="player" preload="none"></audio>

<script define:vars={{ tracks, labels }}>
    const audio = document.getElementById("player");

    const linkEl = document.getElementById("trackLink");
    const titleEl = document.getElementById("trackTitle");
    const artistEl = document.getElementById("trackArtist");
    const coverEl = document.getElementById("diskImg");
    const playBtn = document.getElementById("playBtn");
    const playIcon = document.getElementById("playIcon");
    const nextBtn = document.getElementById("nextBtn");
    const progressEl = document.getElementById("progress");
    const progressBar = document.getElementById("progressBar");
    const timeEl = document.getElementById("time");

    let index = Math.floor(Math.random() * tracks.length);

    function setPlaying(playing) {
        playIcon.textContent = playing ? "⏸" : "▶";
        playBtn.setAttribute("aria-label", playing ? labels.pause : labels.play);
    }

    function loadTrack(i) {
        const track = tracks[i];

        audio.src = track.src;
        linkEl.href = track.url;
        titleEl.textContent = track.title;
        artistEl.textContent = track.artist;
        coverEl.src = track.cover;

        progressEl.style.width = "0%";
        progressBar.setAttribute("aria-valuenow", "0");
        timeEl.textContent = "0:00";
        setPlaying(false);
    }

    function play() {
        audio.play()
            .then(() => setPlaying(true))
            .catch(() => setPlaying(false));
    }

    function togglePlay() {
        if (!audio.src) loadTrack(index);

        if (audio.paused) {
            play();
        } else {
            audio.pause();
            setPlaying(false);
        }
    }

    function nextTrack() {
        index = (index + 1) % tracks.length;
        loadTrack(index);
        play();
    }

    audio.addEventListener("timeupdate", () => {
        const percent = audio.duration
        ? (audio.currentTime / audio.duration) * 100
        : 0;
        progressEl.style.width = `${percent}%`;
        progressBar.setAttribute("aria-valuenow", String(Math.round(percent)));
        timeEl.textContent = formatTime(audio.currentTime);
    });

    audio.addEventListener("ended", nextTrack);

    playBtn.addEventListener("click", togglePlay);
    nextBtn.addEventListener("click", nextTrack);

    function formatTime(s) {
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60);
        return `${m}:${sec.toString().padStart(2, "0")}`;
    }

    loadTrack(index);
</script>