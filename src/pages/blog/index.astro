---
import Layout from "@/layouts/layout.astro";
import PostMeta from "@/components/blog/post-meta.astro";
import IconBook from "@/components/icons/icon-book.astro";
import IconArrowUpRight from "@/components/icons/icon-arrow-up-right.astro";

import { getPosts, getTags, postTransition } from "@/data/blog";
import { useTranslations, getLocale, defaultLocale, localizePath } from "@/i18n";

const locale = getLocale(Astro.currentLocale);
const __ = useTranslations(locale);

// Posts are written in English: marked as such inside a Spanish page
const postLang = locale === defaultLocale ? undefined : defaultLocale;

const posts = await getPosts();
const tags = getTags(posts).slice(0, 8);
---

<Layout
    title="Blog — AMG"
    description={__("Notes on frontend development, Astro, React, Tailwind and the small details that make an interface feel finished.")}
>
    <section class="size-screen mt-32 pb-20" aria-labelledby="blog-title">
        <div class="row flex-wrap items-end justify-between gap-4">
            <div class="col gap-2">
                <div class="row items-center gap-2">
                    <IconBook class="size-7 stroke-white" />

                    <h1 id="blog-title" class="text-3xl font-bold">
                        Blog
                    </h1>
                </div>

                <p class="text-white/80 font-light max-w-md">
                    {__("Notes on frontend, the tools I use every day and the small details that make an interface feel finished.")}
                </p>

                {postLang && (
                    <p class="text-xs text-white/50">
                        {__("Posts are written in English.")}
                    </p>
                )}
            </div>

            <a href="/rss.xml" class="button-main w-fit! px-4 text-xs">
                <span>{__("RSS feed")}</span>
            </a>
        </div>

        {tags.length > 1 && (
            <div id="postFilters" role="group" aria-label={__("Filter posts by topic")} class="row flex-wrap gap-2 mt-8">
                {["all", ...tags].map((tag, i) => (
                    <button
                        type="button"
                        data-filter={tag}
                        aria-pressed={i === 0 ? "true" : "false"}
                        class="box-gen rounded-full! text-xs py-1.5 px-4 transition-colors duration-300 cursor-pointer text-muted aria-pressed:text-white aria-pressed:bg-white/10 aria-pressed:border-white/20!"
                    >
                        {i === 0 ? __("All") : tag}
                    </button>
                ))}
            </div>
        )}

        {posts.length === 0 ? (
            <div class="box-gen mt-8 py-16 col items-center gap-2 text-center">
                <IconBook class="size-8 stroke-white/20" />
                <p class="font-semibold">{__("The first post is on its way")}</p>
                <p class="text-sm text-muted">{__("Subscribe to the RSS feed to catch it when it lands.")}</p>
            </div>
        ) : (
            <ul id="postList" class="pt-8 col gap-4">
                {posts.map((post, i) => {
                    const { title, description, tags } = post.data;
                    const featured = i === 0;

                    return (
                        <li data-tags={tags.join("|")}>
                            <a
                                href={localizePath(`/blog/${post.id}`, locale)}
                                class:list={[
                                    "group box-gen relative overflow-hidden col gap-3 transition-all duration-300 hover:border-white/20!",
                                    featured ? "p-6 md:p-10" : "p-5 md:p-6",
                                ]}
                            >
                                {featured && (
                                    <span
                                        aria-hidden="true"
                                        class="pointer-events-none absolute -top-24 -right-16 size-72 rounded-full bg-violet-500/20 blur-3xl transition-colors duration-500 group-hover:bg-violet-500/30"
                                    />
                                )}

                                <div class="relative row items-start justify-between gap-4">
                                    <div class="col gap-3">
                                        {featured && (
                                            <span class="w-fit rounded-full border border-white/15 bg-white/5 px-2.5 py-0.5 text-[10px] uppercase tracking-wider text-white/70">
                                                {__("Latest")}
                                            </span>
                                        )}

                                        <h2
                                            lang={postLang}
                                            class:list={["font-semibold w-fit text-balance", featured ? "text-2xl md:text-4xl leading-tight" : "text-lg"]}
                                            transition:name={postTransition(post.id)}
                                        >
                                            {title}
                                        </h2>
                                    </div>

                                    <span class="stroke-muted shrink-0 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:stroke-white">
                                        <IconArrowUpRight class="size-4" />
                                    </span>
                                </div>

                                <p lang={postLang} class:list={["relative text-muted leading-relaxed max-w-2xl", featured ? "md:text-lg font-light" : "text-sm line-clamp-2"]}>
                                    {description}
                                </p>

                                <div class="relative row flex-wrap items-center justify-between gap-3 mt-1">
                                    <PostMeta post={post} />

                                    <ul class="row flex-wrap gap-1.5" aria-label={__("Topics")}>
                                        {tags.map((tag) => (
                                            <li class="box-gen rounded-full! text-[10px] leading-3.75 text-muted py-0.5 px-2">
                                                {tag}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </a>
                        </li>
                    );
                })}
            </ul>
        )}
    </section>
</Layout>

<script>
    document.addEventListener("astro:page-load", () => {
        const buttons = document.querySelectorAll<HTMLButtonElement>("#postFilters button");
        const posts = document.querySelectorAll<HTMLLIElement>("#postList > li");

        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const filter = btn.dataset.filter!;

                buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
                posts.forEach((post) => {
                    post.hidden = filter !== "all" && !post.dataset.tags!.split("|").includes(filter);
                });
            });
        });
    });
</script>
