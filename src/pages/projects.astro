---
import Layout from "@/layouts/layout.astro";
import IconProjects from "@/components/icons/icon-projects.astro";
import IconArrowUpRight from "@/components/icons/icon-arrow-up-right.astro";
import { Image } from "astro:assets";

import { getProjects, projectTransition } from "@/data/projects";

const projects = await getProjects();

const filters = [
    { label: "All", value: "all" },
    { label: "Landings", value: "landing" },
    { label: "Apps", value: "app" },
    { label: "Ecommerce", value: "ecommerce" },
];
---

<Layout
    title="Projects — AMG"
    description="A selection of products and platforms I've helped build, from landing pages to full apps and ecommerce sites."
>
    <section class="size-screen mt-32" aria-labelledby="projects-title">
        <div class="col gap-2">
            <div class="row items-center gap-2">
                <IconProjects class="size-7 stroke-white" />

                <h1 id="projects-title" class="text-3xl font-bold">
                    Projects
                </h1>
            </div>

            <p class="text-white/80 font-light max-w-md">
                A selection of products and platforms I've helped build.
                Each one reflects a different stack, industry, and set of
                challenges I worked through with the team.
            </p>
        </div>

        <div id="projectFilters" role="group" aria-label="Filter projects by category" class="row flex-wrap gap-2 mt-8">
            {filters.map((filter, i) => (
                <button
                    type="button"
                    data-filter={filter.value}
                    aria-pressed={i === 0 ? "true" : "false"}
                    class:list={[
                        "box-gen rounded-full! text-xs py-1.5 px-4 transition-colors duration-300 cursor-pointer",
                        i === 0 ? "text-white bg-white/10 border-white/20!" : "text-muted"
                    ]}
                >
                    {filter.label}
                </button>
            ))}
        </div>

        <ul id="projectList" class="py-8 col gap-4">
            {projects.map(({ id, data: project }, i) => (
                <li data-category={project.category}>
                <a
                    href={`/projects/${id}`}
                    class="group box-gen p-4 md:p-5 grid md:grid-cols-5 items-center gap-5 transition-all duration-300 hover:border-white/20!"
                >
                    <div class="md:col-span-2 aspect-video rounded-lg overflow-hidden bg-white/5 relative" transition:name={projectTransition(id).cover}>
                        {project.images[0] ? (
                            <Image
                                src={project.images[0]}
                                alt=""
                                widths={[480, 800]}
                                sizes="(min-width: 768px) 440px, 100vw"
                                loading={i < 2 ? "eager" : "lazy"}
                                class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                            />
                        ) : (
                            <div class="size-full center-content">
                                <IconProjects class="size-8 stroke-white/15" />
                            </div>
                        )}
                    </div>

                    <div class="md:col-span-3 col gap-2">
                        <div class="row items-center justify-between gap-2">
                            <h2 class="text-lg font-semibold group-hover:text-white w-fit" transition:name={projectTransition(id).title}>
                                {project.name}
                            </h2>

                            <span class="stroke-muted shrink-0 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:stroke-white">
                                <IconArrowUpRight class="size-4" />
                            </span>
                        </div>

                        {project.description && (
                            <p class="text-sm text-muted leading-relaxed line-clamp-2">
                                {project.description}
                            </p>
                        )}

                        <ul class="row flex-wrap gap-1.5 mt-1" aria-label="Stack">
                            {project.stack.map((tech) => (
                                <li class="box-gen rounded-full! text-[10px] leading-3.75 text-muted py-0.5 px-2">
                                    {tech}
                                </li>
                            ))}
                        </ul>
                    </div>
                </a>
                </li>
            ))}
        </ul>
    </section>
</Layout>

<script>
    document.addEventListener("astro:page-load", () => {
        const buttons = document.querySelectorAll<HTMLButtonElement>("#projectFilters button");
        const cards = document.querySelectorAll<HTMLLIElement>("#projectList > li");

        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const filter = btn.dataset.filter;

                buttons.forEach((b) => {
                    const isActive = b === btn;
                    b.setAttribute("aria-pressed", String(isActive));
                    b.classList.toggle("text-white", isActive);
                    b.classList.toggle("bg-white/10", isActive);
                    b.classList.toggle("border-white/20!", isActive);
                    b.classList.toggle("text-muted", !isActive);
                });

                cards.forEach((card) => {
                    const show = filter === "all" || card.dataset.category === filter;
                    card.classList.toggle("hidden", !show);
                });
            });
        });
    });
</script>