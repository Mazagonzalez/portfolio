---
import Layout from "@/layouts/layout.astro";
import { useTranslations, localizePath } from "@/i18n";

// Vercel sends every missing URL to this one page, so it renders on demand:
// that way it sees the requested path and answers in Spanish under /es
export const prerender = false;

const __ = useTranslations(Astro.currentLocale);

const links = [
    { href: "/projects", label: __("Projects") },
    { href: "/blog", label: __("Blog") },
    { href: "/about", label: __("About") },
    { href: "/skills", label: __("Skills") },
];
---

<Layout
    title={`${__("Page not found")} — AMG`}
    description={__("The page you're looking for doesn't exist or was moved.")}
    image={{ src: "/OG.png", width: 2400, height: 1254, type: "image/png" }}
    noindex
>
    <section class="size-screen min-h-screen center-content col gap-6 text-center" aria-labelledby="not-found-title">
        <p class="text-8xl md:text-9xl font-bold tracking-tight text-white/10 select-none" aria-hidden="true">
            404
        </p>

        <div class="col items-center gap-2 -mt-4">
            <h1 id="not-found-title" class="text-3xl font-bold">
                {__("Lost in space")}
            </h1>

            <p class="text-white/80 font-light max-w-sm">
                {__("This page doesn't exist or was moved. Let's get you back on track.")}
            </p>
        </div>

        <a href={localizePath("/", Astro.currentLocale)} class="button-main w-fit! px-6">
            <span>{__("Back to home")}</span>
        </a>

        <nav aria-label={__("Other pages")}>
            <ul class="row gap-4 text-sm text-muted">
                {links.map((link) => (
                    <li>
                        <a href={localizePath(link.href, Astro.currentLocale)} class="inline-block px-1 py-2 hover:text-white transition-colors">
                            {link.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </section>
</Layout>
