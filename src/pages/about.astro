---
import Layout from "@/layouts/layout.astro";
import Card from "@/components/ui/card.astro";
import IconUser from "@/components/icons/icon-user.astro";
import IconBook from "@/components/icons/icon-book.astro";
import IconWorkflow from "@/components/icons/icon-workflow.astro";
import IconCoffee from "@/components/icons/icon-coffee.astro";
import IconImage from "@/components/icons/icon-image.astro";
import IconEmail from "@/components/icons/icon-email.astro";
import IconDownload from "@/components/icons/icon-download.astro";
import { useTranslations } from "@/i18n";
import { experience } from "@/data/experience";
import { email } from "@/data/social";
import { getProjects } from "@/data/projects";

const __ = useTranslations(Astro.currentLocale);

// Counted from the data, so they stay true as experience and projects grow
const firstYear = Math.min(...experience.map((item) => Number(item.period.slice(0, 4))));
const projects = await getProjects();

const stats = [
    { value: `${new Date().getFullYear() - firstYear}+`, label: "Years building for the web" },
    { value: String(projects.length), label: "Projects shipped" },
    { value: String(new Set(experience.map((item) => item.company)).size), label: "Companies I've worked with" },
];
---

<Layout
    title={`${__("About")} — AMG`}
    description={__("How Carlos Maza went from planning to study Accounting to becoming a frontend developer, almost by accident.")}
>
    <section class="size-screen mt-32" aria-labelledby="about-title">
        <div class="col gap-2">
            <div class="row items-center gap-2">
                <IconUser class="size-7 stroke-white" />

                <h1 id="about-title" class="text-3xl font-bold">
                    {__("About Me")}
                </h1>
            </div>

            <p class="text-white/80 font-light max-w-sm">
                {__("The short version: I fell into code by accident and never left. Here's the long version.")}
            </p>
        </div>

        <div class="py-20 col gap-5">
            <!-- Row 1: Story + Photo -->
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
                <div class="lg:col-span-2">
                    <Card title={__("My Story")} component={IconBook} height="h-full" overflow={false}>
                        <div slot="content" class="col gap-4">
                            <p class="text-sm text-muted leading-relaxed">
                                {__("I'm a web developer from Barranquilla, Colombia, with about three years of experience building modern apps and websites. Funny thing is, I never planned to end up here — my original plan was to study Accounting.")}
                            </p>

                            <p class="text-sm text-muted leading-relaxed">
                                {__("A friend of mine was studying programming, and out of curiosity I started messing around with a few exercises. When it was time to apply to SENA (Colombia's national training service), I picked programming as a backup option, almost as a joke... and got in. What started as an unexpected turn became one of the best decisions of my life.")}
                            </p>
                        </div>
                    </Card>
                </div>

                <Card headerContent={false} overflow={false}>
                    <div slot="content" class="relative h-68 w-full center-content overflow-hidden rounded-lg border border-dashed border-white/15 bg-white/2" aria-hidden="true">
                        <div class="col items-center gap-2 text-center">
                            <IconImage class="size-6 stroke-white/20" />
                            <span class="text-xs text-white/50">{__("Photo coming soon")}</span>
                        </div>
                    </div>
                </Card>
            </div>

            <!-- Row 2: Quote + Today + Photo -->
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
                <Card headerContent={false} height="h-40 md:h-80">
                    <figure slot="content" class="size-full center-content col gap-2 text-center px-7 absolute-center">
                        <blockquote lang="la" class="text-xl font-semibold tracking-wide">
                            <p>"Per Aspera Ad Astra"</p>
                        </blockquote>

                        <figcaption class="text-xs text-white/50">
                            {__("Through hardships, to the stars — the line I keep coming back to.")}
                        </figcaption>
                    </figure>
                </Card>

                <Card title={__("What I Do Today")} component={IconWorkflow}>
                    <div slot="content" class="col gap-3">
                        <p class="text-sm text-muted leading-relaxed">
                            {__("These days I especially enjoy frontend development — mixing logic with design to build interfaces that feel intuitive and look good. I care about solving problems, keeping my code clean, and sweating the small visual details that make an experience feel finished.")}
                        </p>

                        <p class="text-sm text-muted leading-relaxed">
                            {__("I'm always learning new tech and trying to get better at what I do, because constant learning is just part of building better products.")}
                        </p>
                    </div>
                </Card>

                <div class="md:col-span-2 lg:col-span-1">
                    <Card headerContent={false} overflow={false}>
                        <div slot="content" class="relative h-68 w-full center-content overflow-hidden rounded-lg border border-dashed border-white/15 bg-white/2" aria-hidden="true">
                            <div class="col items-center gap-2 text-center">
                                <IconImage class="size-6 stroke-white/20" />
                                <span class="text-xs text-white/50">{__("Photo coming soon")}</span>
                            </div>
                        </div>
                    </Card>
                </div>
            </div>

            <!-- Row 3: Numbers -->
            <dl class="grid grid-cols-3 gap-3 md:gap-5">
                {stats.map((stat) => (
                    <div class="box-gen p-4 md:p-5 col-reverse justify-end gap-1">
                        <dt class="text-xs text-muted leading-snug">{__(stat.label)}</dt>
                        <dd class="text-2xl md:text-3xl font-bold">{stat.value}</dd>
                    </div>
                ))}
            </dl>

            <!-- Row 4: Off the clock + Photo -->
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
                <div class="lg:col-span-2">
                    <Card title={__("Off the Clock")} component={IconCoffee} height="h-full" overflow={false}>
                        <div slot="content" class="col gap-4">
                            <p class="text-sm text-muted leading-relaxed">
                                {__("When I'm not coding: music always playing, deep in a video game, binging a new series, or re-watching Star Wars for the hundredth time (yes, I'm that fan). I'm pretty easygoing — always down for good food and even better company.")}
                            </p>
                        </div>
                    </Card>
                </div>

                <Card headerContent={false} overflow={false} height="h-fit">
                    <div slot="content" class="relative h-40 w-full center-content overflow-hidden rounded-lg border border-dashed border-white/15 bg-white/2" aria-hidden="true">
                        <div class="col items-center gap-2 text-center">
                            <IconImage class="size-6 stroke-white/20" />
                            <span class="text-xs text-white/50">{__("Photo coming soon")}</span>
                        </div>
                    </div>
                </Card>
            </div>

            <!-- Row 5: Call to action -->
            <Card headerContent={false} height="h-fit">
                <div slot="content" class="flex flex-col md:flex-row md:items-center md:justify-between gap-5">
                    <div class="col gap-1">
                        <h2 class="text-xl font-semibold">{__("Want to build something together?")}</h2>
                        <p class="text-sm text-muted">{__("I'm open to new projects and teams. Tell me what you have in mind.")}</p>
                    </div>

                    <div class="row flex-wrap gap-2 shrink-0">
                        <a href={`mailto:${email}`} class="button-main w-fit! px-5">
                            <IconEmail class="size-4 stroke-zinc-400" />
                            <span class="text-sm">{__("Send an email")}</span>
                        </a>

                        <a href="/Carlos-Maza-CV.pdf" download class="button-main w-fit! px-5">
                            <IconDownload class="size-4 stroke-zinc-400" />
                            <span class="text-sm">{__("Download CV")}</span>
                        </a>
                    </div>
                </div>
            </Card>
        </div>
    </section>
</Layout>
