---
import Layout from "@/layouts/layout.astro";
import Carousel from "@/components/ui/carousel.astro";
import IconArrowUpRight from "@/components/icons/icon-arrow-up-right.astro";
import IconChevron from "@/components/icons/icon-chevron.astro";
import IconGithub from "@/components/icons/icon-github.astro";
import { render } from "astro:content";

import { getProjectPaths, projectTransition, categoryLabels } from "@/data/projects";
import { useTranslations, getLocale, defaultLocale, localizePath } from "@/i18n";

export const getStaticPaths = getProjectPaths;

const locale = getLocale(Astro.currentLocale);
const __ = useTranslations(locale);

const { project } = Astro.props;
const { data } = project;
const transition = projectTransition(project.id);
const { Content } = await render(project);
const hasContent = Boolean(project.body?.trim());

const description = data.description ? __(data.description) : __(":name — a project by Carlos Maza.", { name: data.name });

const details = [
    { label: __("Year"), value: data.year },
    { label: __("Role"), value: data.role && __(data.role) },
    { label: __("Type"), value: __(categoryLabels[data.category]) },
].filter((detail) => detail.value);
---

<Layout
    title={`${data.name} — AMG`}
    description={description}
>
    <article class="size-screen mt-32 col gap-6" aria-labelledby="project-title">
        <div class="col gap-3">
            <div class="row items-center flex-wrap gap-4">
                <a
                    href={localizePath("/projects", locale)}
                    aria-label={__("Back to projects")}
                    class="rotate-180 -mr-2"
                >
                    <IconChevron class="size-6 stroke-muted hover:stroke-white" />
                </a>

                <h1 id="project-title" class="text-3xl font-bold" transition:name={transition.title}>
                    {data.name}
                </h1>

                {data.url && (
                    <a
                        href={data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="button-main w-fit! px-5 stroke-muted hover:stroke-white"
                    >
                        <span>{__("Visit site")}</span>
                        <span class="sr-only">{__("(opens in a new tab)")}</span>
                        <IconArrowUpRight class="size-4" />
                    </a>
                )}

                {data.repo && (
                    <a
                        href={data.repo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="button-main w-fit! px-5 stroke-muted hover:stroke-white"
                    >
                        <IconGithub class="size-4" />
                        <span>{__("Source code")}</span>
                        <span class="sr-only">{__("(opens in a new tab)")}</span>
                    </a>
                )}
            </div>

            {data.description && (
                <p class="text-white/80 font-light max-w-2xl">
                    {description}
                </p>
            )}

            <ul class="row flex-wrap gap-1.5" aria-label={__("Stack")}>
                {data.stack.map((tech) => (
                    <li class="box-gen rounded-full! text-xs text-muted py-1 px-3">
                        {tech}
                    </li>
                ))}
            </ul>
        </div>

        <div class="pt-6">
            <Carousel images={data.images} alt={data.name} transitionName={transition.cover} />
        </div>

        <div class="grid md:grid-cols-4 gap-8 pb-20">
            {details.length > 0 && (
                <dl class="col gap-4 md:order-last">
                    {details.map((detail) => (
                        <div class="col gap-1">
                            <dt class="text-xs text-muted uppercase tracking-wider">{detail.label}</dt>
                            <dd class="text-sm">{detail.value}</dd>
                        </div>
                    ))}
                </dl>
            )}

            <!-- Case studies are written in English -->
            {hasContent && (
                <div class="prose-case md:col-span-3" lang={locale === defaultLocale ? undefined : defaultLocale}>
                    <Content />
                </div>
            )}
        </div>
    </article>
</Layout>
