---
import Layout from "@/layouts/layout.astro";
import Carousel from "@/components/ui/carousel.astro";
import IconArrowUpRight from "@/components/icons/icon-arrow-up-right.astro";
import IconChevron from "@/components/icons/icon-chevron.astro";
import IconGithub from "@/components/icons/icon-github.astro";
import { getImage } from "astro:assets";
import { render } from "astro:content";

import { getProjects } from "@/data/projects";

export async function getStaticPaths() {
    const projects = await getProjects();

    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const hasContent = Boolean(project.body?.trim());

// Social previews: 1200px JPG of the cover (WebP/AVIF aren't supported everywhere)
const cover = data.images[0];
const ogImage = cover
    ? await getImage({ src: cover, width: 1200, format: "jpg" })
    : undefined;

const details = [
    { label: "Year", value: data.year },
    { label: "Role", value: data.role },
    { label: "Type", value: { landing: "Landing page", app: "Web app", ecommerce: "Ecommerce" }[data.category] },
].filter((detail) => detail.value);
---

<Layout
    title={`${data.name} — AMG`}
    description={data.description || `${data.name} — a project by Carlos Maza.`}
    image={ogImage && {
        src: ogImage.src,
        width: ogImage.attributes.width,
        height: ogImage.attributes.height,
        type: "image/jpeg",
    }}
    imageAlt={ogImage && `${data.name} — screenshot`}
>
    <article class="size-screen mt-32 col gap-6" aria-labelledby="project-title">
        <div class="col gap-3">
            <div class="row items-center flex-wrap gap-4">
                <a
                    href="/projects"
                    aria-label="Back to projects"
                    class="rotate-180 -mr-2"
                >
                    <IconChevron class="size-6 stroke-muted hover:stroke-white" />
                </a>

                <h1 id="project-title" class="text-3xl font-bold">
                    {data.name}
                </h1>

                {data.url && (
                    <a
                        href={data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="button-main w-fit! px-5 stroke-muted hover:stroke-white"
                    >
                        <span>Visit site</span>
                        <span class="sr-only">(opens in a new tab)</span>
                        <IconArrowUpRight class="size-4" />
                    </a>
                )}

                {data.repo && (
                    <a
                        href={data.repo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="button-main w-fit! px-5 stroke-muted hover:stroke-white"
                    >
                        <IconGithub class="size-4" />
                        <span>Source code</span>
                        <span class="sr-only">(opens in a new tab)</span>
                    </a>
                )}
            </div>

            {data.description && (
                <p class="text-white/80 font-light max-w-2xl">
                    {data.description}
                </p>
            )}

            <ul class="row flex-wrap gap-1.5" aria-label="Stack">
                {data.stack.map((tech) => (
                    <li class="box-gen rounded-full! text-xs text-muted py-1 px-3">
                        {tech}
                    </li>
                ))}
            </ul>
        </div>

        <div class="pt-6">
            <Carousel images={data.images} alt={data.name} />
        </div>

        <div class="grid md:grid-cols-4 gap-8 pb-20">
            {details.length > 0 && (
                <dl class="col gap-4 md:order-last">
                    {details.map((detail) => (
                        <div class="col gap-1">
                            <dt class="text-xs text-muted uppercase tracking-wider">{detail.label}</dt>
                            <dd class="text-sm">{detail.value}</dd>
                        </div>
                    ))}
                </dl>
            )}

            {hasContent && (
                <div class="prose-case md:col-span-3">
                    <Content />
                </div>
            )}
        </div>
    </article>
</Layout>
