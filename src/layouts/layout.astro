---
import { ClientRouter } from "astro:transitions";
import UsageAurora from "@/components/ui/usage-aurora";
import Navbar from "@/components/navbar.astro";
import Footer from "@/components/footer.astro";

import "../styles/global.css";

const {
	title = "AMG - devel",
	description = "Carlos Maza — frontend developer from Barranquilla, Colombia building fast, thoughtful web experiences.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<ClientRouter transition:persist />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet">

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Open Graph -->
		<meta property="og:locale" content="es_CO">
		<meta property="og:type" content="website">
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:url" content={canonicalURL}>
		<meta property="og:site_name" content="AMG - devel">
		<meta property="og:image" content="https://portfolio-vovx.vercel.app/OG.png">
		<meta property="og:image:secure_url" content="https://portfolio-vovx.vercel.app/OG.webp">
		<meta property="og:image:type" content="image/png">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">

		<!-- Twitter -->
		<meta name="twitter:card" content="summary">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "Person",
						"name": "Carlos Maza",
						"jobTitle": "Frontend Developer",
						"url": "https://portfolio-vovx.vercel.app/favicon.ico",
						"email": "mailto:mazagonzalez61@gmail.com",
						"description": "Carlos Maza — frontend developer from Barranquilla, Colombia building fast, thoughtful web experiences.",
						"sameAs": [
							"https://github.com/Mazagonzalez",
							"https://www.linkedin.com/in/carlos-arturo-maza-gonzalez-254b70249",
							"https://www.instagram.com/carlosmaza_17/"
						]
					},
					{
						"@type": "WebSite",
						"url": "https://portfolio-vovx.vercel.app/",
						"name": "AMG - devel"
					},
					{
						"@type": "WebPage",
						"url": "https://portfolio-vovx.vercel.app/",
						"name": "Home",
						"isPartOf": { "@id": "https://portfolio-vovx.vercel.app/" }
					}
				]
			}
		</script>
	</head>
	<body class="scrollbar">
		<div class="fixed top-0 left-0 w-screen h-screen">
			<UsageAurora 
				client:only="react" 
			/>
		</div>

		<Navbar />

		<main class="scrollbar relative z-10">	
			<slot />
		</main>

		<Footer />
	</body>
</html>

<script is:inline>
    // Scroll to section
    function scrollToSection(sectionId) {
        var section = document.getElementById(sectionId);
        if (section) {
            section.scrollIntoView({ behavior: 'smooth' });
        }
    }
    // End Scroll to section
</script>

<style is:global>
	html {
		background-color: #171717;
		color: white;
		scroll-behavior: smooth;
		font-family: "Geist", sans-serif;
	}

	@media(prefers-reduce-motion: reduce){
        html{
        scroll-behavior: auto;
        }
	}
</style>
