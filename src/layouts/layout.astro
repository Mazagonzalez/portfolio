---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Aurora from "@/components/backgrounds/aurora.jsx";
import Navbar from "@/components/layout/navbar.astro";
import Footer from "@/components/layout/footer.astro";
import VercelInsights from "@/components/layout/vercel-insights.astro";
import CommandPalette from "@/components/layout/command-palette.astro";
import EasterEgg from "@/components/layout/easter-egg.astro";
import LanguageSwitcher from "@/components/layout/language-switcher.astro";
import { email, socialLinks } from "@/data/social";
import { useTranslations, getLocale, defaultLocale, localeCodes, locales, localizePath, stripLocale, isTranslated } from "@/i18n";

import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	image?: { src: string; width: number; height: number; type: string };
	imageAlt?: string;
	noindex?: boolean;
	article?: { headline: string; publishedTime: Date; modifiedTime?: Date; tags: string[] };
}

const locale = getLocale(Astro.currentLocale);
const __ = useTranslations(locale);
const page = stripLocale(Astro.url.pathname);

// Blog posts are only written in English: their /es page (Spanish interface)
// points search engines to the English one, and shares its Open Graph image
const englishArticle = Boolean(Astro.props.article) && locale !== defaultLocale;

// Each page gets its generated Open Graph image: /about -> /og/about.png, /es/about -> /og/es/about.png
const ogPrefix = locale === defaultLocale || englishArticle ? "" : `/${locale}`;
const ogPath = `${ogPrefix}${page.replace(/\/$/, "") || "/index"}`;

const siteDescription = __("Carlos Maza — frontend developer from Barranquilla, Colombia building fast, thoughtful web experiences.");

const {
	title = "AMG - devel",
	description = siteDescription,
	image = { src: `/og${ogPath}.png`, width: 1200, height: 630, type: "image/png" },
	imageAlt = title,
	noindex = false,
	// Blog posts: og:type "article" plus their BlogPosting node in the JSON-LD
	article,
} = Astro.props;

const canonicalURL = new URL(englishArticle ? page : Astro.url.pathname, Astro.site);
const siteURL = new URL("/", Astro.site).href;
const imageURL = new URL(image.src, Astro.site).href;

// The same page in every language, for the language switcher and hreflang
const alternates = !noindex && isTranslated(page)
	? locales.map((code) => ({ locale: code, href: new URL(localizePath(page, code), Astro.site).href }))
	: [];
const hreflangs = Astro.props.article ? [] : alternates;
const ogLocale = (code: string) => localeCodes[getLocale(code)].replace("-", "_");

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": `${siteURL}#person`,
			name: "Carlos Maza",
			jobTitle: "Frontend Developer",
			url: siteURL,
			email: `mailto:${email}`,
			description: siteDescription,
			sameAs: socialLinks.filter((link) => link.target).map((link) => link.url),
		},
		{
			"@type": "WebSite",
			"@id": `${siteURL}#website`,
			url: siteURL,
			name: "AMG - devel",
			publisher: { "@id": `${siteURL}#person` },
		},
		{
			"@type": "WebPage",
			"@id": `${canonicalURL.href}#webpage`,
			url: canonicalURL.href,
			name: title,
			description,
			inLanguage: localeCodes[locale],
			isPartOf: { "@id": `${siteURL}#website` },
			about: { "@id": `${siteURL}#person` },
		},
		...(article
			? [{
				"@type": "BlogPosting",
				"@id": `${canonicalURL.href}#article`,
				headline: article.headline,
				inLanguage: localeCodes[defaultLocale],
				description,
				image: imageURL,
				datePublished: article.publishedTime.toISOString(),
				dateModified: (article.modifiedTime ?? article.publishedTime).toISOString(),
				keywords: article.tags,
				author: { "@id": `${siteURL}#person` },
				publisher: { "@id": `${siteURL}#person` },
				mainEntityOfPage: { "@id": `${canonicalURL.href}#webpage` },
			}]
			: []),
	],
};
---

<!doctype html>
<html lang={locale} class="has-[#cmdk[open]]:overflow-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{hreflangs.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />)}
		{hreflangs.length > 0 && <link rel="alternate" hreflang="x-default" href={hreflangs[0].href} />}
		{noindex && <meta name="robots" content="noindex" />}
		<ClientRouter transition:persist />

		<!-- Fonts (self-hosted, see `fonts` in astro.config.mjs) -->
		<!-- Only the upright style is preloaded; italics (rare) load on demand -->
		<Font cssVariable="--font-geist" preload={[{ style: "normal" }]} />

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Blog feed -->
		<link rel="alternate" type="application/rss+xml" title="AMG - devel blog" href={new URL("/rss.xml", Astro.site)} />

		<!-- Open Graph -->
		<meta property="og:locale" content={ogLocale(locale)}>
		{hreflangs.filter((alternate) => alternate.locale !== locale).map((alternate) => <meta property="og:locale:alternate" content={ogLocale(alternate.locale)}>)}
		<meta property="og:type" content={article ? "article" : "website"}>
		{article && <meta property="article:published_time" content={article.publishedTime.toISOString()}>}
		{article?.tags.map((tag) => <meta property="article:tag" content={tag}>)}
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:url" content={canonicalURL}>
		<meta property="og:site_name" content="AMG - devel">
		<meta property="og:image" content={imageURL}>
		<meta property="og:image:secure_url" content={imageURL}>
		<meta property="og:image:type" content={image.type}>
		<meta property="og:image:width" content={String(image.width)}>
		<meta property="og:image:height" content={String(image.height)}>
		<meta property="og:image:alt" content={imageAlt}>

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={imageURL}>
		<meta name="twitter:image:alt" content={imageAlt}>

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="scrollbar">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-black focus:px-4 focus:py-2 focus:text-sm"
		>
			{__("Skip to content")}
		</a>

		<div class="fixed top-0 left-0 w-screen h-screen" aria-hidden="true" transition:persist="aurora">
			<Aurora
				client:only="react"
				colorStops={["#7E57C7", "#1D93C2", "#7453ED"]}
				blend={0.5}
				amplitude={2.5}
				speed={0.3}
			/>
		</div>

		<LanguageSwitcher alternates={alternates} />

		<Navbar />

		<main id="main" tabindex="-1" class="scrollbar relative z-10 outline-none">	
			<slot />
		</main>

		<Footer />

		<CommandPalette />
		
		<EasterEgg />

		<VercelInsights />
	</body>
</html>

<style is:global>
	html {
		background-color: var(--color-surface);
		color: white;
		scroll-behavior: smooth;
	}

	@media(prefers-reduced-motion: reduce){
        html{
        scroll-behavior: auto;
        }
	}
</style>
