---
import { ClientRouter } from "astro:transitions";
import UsageAurora from "@/components/ui/usage-aurora";
import Navbar from "@/components/navbar.astro";
import Footer from "@/components/footer.astro";

import "../styles/global.css";

const {
	title = "AMG - devel",
	description = "Carlos Maza — frontend developer from Barranquilla, Colombia building fast, thoughtful web experiences.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<ClientRouter transition:persist />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet">

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Open Graph -->
		<meta property="og:locale" content="en_US">
		<meta property="og:type" content="website">
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:url" content={canonicalURL}>
		<meta property="og:site_name" content="AMG - devel">
		<meta property="og:image" content="https://amg-devel.vercel.app/OG.png">
		<meta property="og:image:secure_url" content="https://amg-devel.vercel.app/OG.png">
		<meta property="og:image:type" content="image/png">
		<meta property="og:image:width" content="2400">
		<meta property="og:image:height" content="1254">
		<meta property="og:image:alt" content="Carlos Maza — Frontend Developer">

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content="https://amg-devel.vercel.app/OG.png">

		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "Person",
						"name": "Carlos Maza",
						"jobTitle": "Frontend Developer",
						"url": "https://amg-devel.vercel.app/",
						"email": "mailto:mazagonzalez61@gmail.com",
						"description": "Carlos Maza — frontend developer from Barranquilla, Colombia building fast, thoughtful web experiences.",
						"sameAs": [
							"https://github.com/Mazagonzalez",
							"https://www.linkedin.com/in/carlos-arturo-maza-gonzalez",
							"https://www.instagram.com/carlosmaza_17/"
						]
					},
					{
						"@type": "WebSite",
						"url": "https://amg-devel.vercel.app/",
						"name": "AMG - devel"
					},
					{
						"@type": "WebPage",
						"url": "https://amg-devel.vercel.app/",
						"name": "Home",
						"isPartOf": { "@id": "https://amg-devel.vercel.app/" }
					}
				]
			}
		</script>
	</head>
	<body class="scrollbar">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-black focus:px-4 focus:py-2 focus:text-sm"
		>
			Skip to content
		</a>

		<div class="fixed top-0 left-0 w-screen h-screen" aria-hidden="true">
			<UsageAurora 
				client:only="react" 
			/>
		</div>

		<Navbar />

		<main id="main" tabindex="-1" class="scrollbar relative z-10 outline-none">	
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	html {
		background-color: #171717;
		color: white;
		scroll-behavior: smooth;
		font-family: "Geist", sans-serif;
	}

	@media(prefers-reduced-motion: reduce){
        html{
        scroll-behavior: auto;
        }
	}
</style>
