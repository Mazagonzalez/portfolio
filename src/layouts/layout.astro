---
import { ClientRouter } from "astro:transitions";
import Aurora from "@/components/backgrounds/aurora.jsx";
import Navbar from "@/components/layout/navbar.astro";
import Footer from "@/components/layout/footer.astro";
import VercelInsights from "@/components/layout/vercel-insights.astro";
import CommandPalette from "@/components/layout/command-palette.astro";
import EasterEgg from "@/components/layout/easter-egg.astro";
import { email, socialLinks } from "@/data/social";

import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	image?: { src: string; width: number; height: number; type: string };
	imageAlt?: string;
	noindex?: boolean;
	article?: { headline: string; publishedTime: Date; modifiedTime?: Date; tags: string[] };
}

// Each page gets its generated Open Graph image: /about -> /og/about.png
const ogPath = Astro.url.pathname.replace(/\/$/, "") || "/index";

const {
	title = "AMG - devel",
	description = "Carlos Maza — frontend developer from Barranquilla, Colombia building fast, thoughtful web experiences.",
	image = { src: `/og${ogPath}.png`, width: 1200, height: 630, type: "image/png" },
	imageAlt = title,
	noindex = false,
	// Blog posts: og:type "article" plus their BlogPosting node in the JSON-LD
	article,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = new URL("/", Astro.site).href;
const imageURL = new URL(image.src, Astro.site).href;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": `${siteURL}#person`,
			name: "Carlos Maza",
			jobTitle: "Frontend Developer",
			url: siteURL,
			email: `mailto:${email}`,
			description: "Carlos Maza — frontend developer from Barranquilla, Colombia building fast, thoughtful web experiences.",
			sameAs: socialLinks.filter((link) => link.target).map((link) => link.url),
		},
		{
			"@type": "WebSite",
			"@id": `${siteURL}#website`,
			url: siteURL,
			name: "AMG - devel",
			publisher: { "@id": `${siteURL}#person` },
		},
		{
			"@type": "WebPage",
			"@id": `${canonicalURL.href}#webpage`,
			url: canonicalURL.href,
			name: title,
			description,
			isPartOf: { "@id": `${siteURL}#website` },
			about: { "@id": `${siteURL}#person` },
		},
		...(article
			? [{
				"@type": "BlogPosting",
				"@id": `${canonicalURL.href}#article`,
				headline: article.headline,
				description,
				image: imageURL,
				datePublished: article.publishedTime.toISOString(),
				dateModified: (article.modifiedTime ?? article.publishedTime).toISOString(),
				keywords: article.tags,
				author: { "@id": `${siteURL}#person` },
				publisher: { "@id": `${siteURL}#person` },
				mainEntityOfPage: { "@id": `${canonicalURL.href}#webpage` },
			}]
			: []),
	],
};
---

<!doctype html>
<html lang="en" class="has-[#cmdk[open]]:overflow-hidden">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex" />}
		<ClientRouter transition:persist />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet">

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Blog feed -->
		<link rel="alternate" type="application/rss+xml" title="AMG - devel blog" href={new URL("/rss.xml", Astro.site)} />

		<!-- Open Graph -->
		<meta property="og:locale" content="en_US">
		<meta property="og:type" content={article ? "article" : "website"}>
		{article && <meta property="article:published_time" content={article.publishedTime.toISOString()}>}
		{article?.tags.map((tag) => <meta property="article:tag" content={tag}>)}
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:url" content={canonicalURL}>
		<meta property="og:site_name" content="AMG - devel">
		<meta property="og:image" content={imageURL}>
		<meta property="og:image:secure_url" content={imageURL}>
		<meta property="og:image:type" content={image.type}>
		<meta property="og:image:width" content={String(image.width)}>
		<meta property="og:image:height" content={String(image.height)}>
		<meta property="og:image:alt" content={imageAlt}>

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={imageURL}>
		<meta name="twitter:image:alt" content={imageAlt}>

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="scrollbar">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-black focus:px-4 focus:py-2 focus:text-sm"
		>
			Skip to content
		</a>

		<div class="fixed top-0 left-0 w-screen h-screen" aria-hidden="true" transition:persist="aurora">
			<Aurora
				client:only="react"
				colorStops={["#7E57C7", "#1D93C2", "#7453ED"]}
				blend={0.5}
				amplitude={2.5}
				speed={0.3}
			/>
		</div>

		<Navbar />

		<main id="main" tabindex="-1" class="scrollbar relative z-10 outline-none">	
			<slot />
		</main>

		<Footer />

		<CommandPalette />
		
		<EasterEgg />

		<VercelInsights />
	</body>
</html>

<style is:global>
	html {
		background-color: var(--color-surface);
		color: white;
		scroll-behavior: smooth;
		font-family: "Geist", sans-serif;
	}

	@media(prefers-reduced-motion: reduce){
        html{
        scroll-behavior: auto;
        }
	}
</style>
